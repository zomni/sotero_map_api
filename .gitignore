# .env con credenciales — NUNCA subir al repo
.env

# Build outputs
**/bin/
**/obj/
out/

# User secrets
**/appsettings.Development.json

# VS / Rider
.vs/
.idea/
*.user

# Migrations generadas localmente (opcional dejarlo fuera)
# **/Migrations/

# SQLite locales residuales del backend
SoteroMap.API/soteromap.db*

# Datos vivos del proyecto (camino B: paquete separado, no versionar)
data/**
!data/.gitkeep
!data/README.md
!data/backups/
!data/backups/.gitkeep
!data/inventory-forms/
!data/inventory-forms/.gitkeep
!data/data-protection-keys/
!data/data-protection-keys/.gitkeep

# Paquetes/exportaciones y runtime locales
runtime/**

# Respaldos legacy del backend
SoteroMap.API/backups/**

# Temporales de trabajo locales
.tmp/**

# Configuracion local del collector
tools/SoteroMap.NetworkCollector/appsettings.local.json

# Temporales locales grandes
_container_soteromap.db
tmp_json_test.cs
_tmp_dbcheck.cs

