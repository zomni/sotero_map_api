@model SoteroMap.API.ViewModels.AdminActivityViewModel
@{
    ViewData["Title"] = "Auditoria";
    Layout = "~/Views/Shared/_Layout.cshtml";

    object activityModel = Model;
    string GetModelString(string propertyName)
    {
        var value = activityModel.GetType().GetProperty(propertyName)?.GetValue(activityModel);
        return value?.ToString() ?? string.Empty;
    }

    int GetModelInt(string propertyName, int fallback = 0)
    {
        var value = activityModel.GetType().GetProperty(propertyName)?.GetValue(activityModel);
        return value is null ? fallback : Convert.ToInt32(value);
    }

    IReadOnlyList<object> GetModelItems()
    {
        var value = activityModel.GetType().GetProperty("Items")?.GetValue(activityModel);
        if (value is System.Collections.IEnumerable enumerable)
        {
            return enumerable.Cast<object>().ToList();
        }

        return Array.Empty<object>();
    }

    string GetItemString(object item, string propertyName)
    {
        var value = item.GetType().GetProperty(propertyName)?.GetValue(item);
        return value?.ToString() ?? string.Empty;
    }

    var buildingExternalId = GetModelString("BuildingExternalId");
    var changedByUsername = GetModelString("ChangedByUsername");
    var actionType = GetModelString("ActionType");
    var resource = GetModelString("Resource");
    var result = GetModelString("Result");
    var severity = GetModelString("Severity");
    var search = GetModelString("Search");
    var clientIp = GetModelString("ClientIp");
    var userAgent = GetModelString("UserAgent");
    var dateFrom = GetModelString("DateFrom");
    var dateTo = GetModelString("DateTo");
    var page = Math.Max(1, GetModelInt("Page", 1));
    var pageSize = GetModelInt("PageSize", 50);
    var totalCount = GetModelInt("TotalCount", Model.Items.Count);
    var totalPages = Math.Max(1, GetModelInt("TotalPages", 1));
    var successCount = GetModelInt("SuccessCount");
    var failureCount = GetModelInt("FailureCount");
    var criticalCount = GetModelInt("CriticalCount");
    var warningCount = GetModelInt("WarningCount");
    var items = GetModelItems();

    var activeFilters = new List<string>();
    if (!string.IsNullOrWhiteSpace(buildingExternalId)) { activeFilters.Add($"Edificio: {buildingExternalId}"); }
    if (!string.IsNullOrWhiteSpace(changedByUsername)) { activeFilters.Add($"Usuario: {changedByUsername}"); }
    if (!string.IsNullOrWhiteSpace(actionType)) { activeFilters.Add($"Accion: {actionType}"); }
    if (!string.IsNullOrWhiteSpace(resource)) { activeFilters.Add($"Recurso: {resource}"); }
    if (!string.IsNullOrWhiteSpace(result)) { activeFilters.Add($"Resultado: {result}"); }
    if (!string.IsNullOrWhiteSpace(severity)) { activeFilters.Add($"Severidad: {severity}"); }
    if (!string.IsNullOrWhiteSpace(search)) { activeFilters.Add($"Texto: {search}"); }
    if (!string.IsNullOrWhiteSpace(clientIp)) { activeFilters.Add($"IP: {clientIp}"); }
    if (!string.IsNullOrWhiteSpace(userAgent)) { activeFilters.Add($"Agente: {userAgent}"); }
    if (!string.IsNullOrWhiteSpace(dateFrom)) { activeFilters.Add($"Desde: {dateFrom}"); }
    if (!string.IsNullOrWhiteSpace(dateTo)) { activeFilters.Add($"Hasta: {dateTo}"); }
    if (pageSize != 30) { activeFilters.Add($"Por pagina: {pageSize}"); }

    List<KeyValuePair<string, string?>> BuildActivityQuery(int? pageOverride = null, int? pageSizeOverride = null)
    {
        var query = new List<KeyValuePair<string, string?>>();

        void Add(string key, string? value)
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                query.Add(new KeyValuePair<string, string?>(key, value));
            }
        }

        Add("buildingExternalId", buildingExternalId);
        Add("changedByUsername", changedByUsername);
        Add("actionType", actionType);
        Add("resource", resource);
        Add("result", result);
        Add("severity", severity);
        Add("search", search);
        Add("clientIp", clientIp);
        Add("userAgent", userAgent);
        Add("from", dateFrom);
        Add("to", dateTo);

        query.Add(new KeyValuePair<string, string?>("page", (pageOverride ?? 1).ToString()));
        query.Add(new KeyValuePair<string, string?>("pageSize", (pageSizeOverride ?? pageSize).ToString()));
        return query;
    }

    string BuildActivityUrl(int? pageOverride = null, int? pageSizeOverride = null)
        => Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(
            "/admin/activity",
            BuildActivityQuery(pageOverride, pageSizeOverride));
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Auditoria formal</h2>
        <div class="text-muted">Eventos sensibles con usuario, IP, agente, resultado y valores previos/nuevos.</div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3 fade-in-up fade-in-up-d1">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="dashboard-kpi-icon bg-primary bg-opacity-10">
                        <i class="bi bi-search text-primary fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total encontrados</div>
                        <div class="fs-3 fw-bold">@totalCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 fade-in-up fade-in-up-d2">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="dashboard-kpi-icon bg-success bg-opacity-10">
                        <i class="bi bi-check2-circle text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Exitos</div>
                        <div class="fs-3 fw-bold">@successCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 fade-in-up fade-in-up-d3">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="dashboard-kpi-icon bg-danger bg-opacity-10">
                        <i class="bi bi-x-circle text-danger fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Fallos</div>
                        <div class="fs-3 fw-bold">@failureCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 fade-in-up fade-in-up-d4">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="dashboard-kpi-icon bg-dark bg-opacity-10">
                        <i class="bi bi-exclamation-triangle text-dark fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Criticos</div>
                        <div class="fs-3 fw-bold">@criticalCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 fade-in-up fade-in-up-d5">
        <div class="card dashboard-card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="dashboard-kpi-icon bg-warning bg-opacity-10">
                        <i class="bi bi-exclamation-circle text-warning fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Advertencias</div>
                        <div class="fs-3 fw-bold">@warningCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
        transition: transform .28s ease, box-shadow .28s ease;
    }
    .dashboard-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
    }
    .dashboard-kpi-icon {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        transition: transform .3s ease, box-shadow .3s ease;
    }
    .dashboard-card:hover .dashboard-kpi-icon {
        transform: scale(1.08);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
    }
    .fade-in-up {
        animation: fadeUp .5s ease both;
    }
    .fade-in-up-d1 { animation-delay: .05s; }
    .fade-in-up-d2 { animation-delay: .1s; }
    .fade-in-up-d3 { animation-delay: .15s; }
    .fade-in-up-d4 { animation-delay: .2s; }
    .fade-in-up-d5 { animation-delay: .25s; }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(18px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .inventory-filter-panel {
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 1rem;
        background: linear-gradient(180deg, #fbfdff 0%, #f8fafc 100%);
        padding: 1.25rem;
    }
    .inventory-filter-fixed {
        border: 1px solid rgba(148, 163, 184, 0.24);
        border-radius: 0.9rem;
        background: #fff;
        padding: 0.85rem;
        height: 100%;
    }
    .inventory-filter-fixed .filter-title {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #475569;
        margin-bottom: 0.55rem;
    }
    .inventory-filter-active-bar {
        border: 1px dashed rgba(14, 116, 144, 0.18);
        border-radius: 0.9rem;
        background: rgba(255, 255, 255, 0.85);
        padding: 0.85rem;
    }
    .inventory-filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 0.8rem;
        border-radius: 0.9rem;
        border: 1px solid rgba(148, 163, 184, 0.24);
        background: #ffffff;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
    }
</style>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="inventory-filter-panel">
            <input type="hidden" name="page" value="1" />

            @if (activeFilters.Count > 0)
            {
                <div class="inventory-filter-active-bar mb-3">
                    <div class="small text-muted mb-2">Filtros activos (@activeFilters.Count)</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var filter in activeFilters)
                        {
                            <div class="inventory-filter-chip">
                                <span class="fw-semibold">@filter</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="row g-3">
                <div class="col-xl-3 col-lg-6">
                    <div class="inventory-filter-fixed">
                        <div class="filter-title">Usuario</div>
                        <input type="text" name="changedByUsername" value="@changedByUsername" class="form-control" placeholder="admin" />
                    </div>
                </div>
                <div class="col-xl-3 col-lg-6">
                    <div class="inventory-filter-fixed">
                        <div class="filter-title">Edificio</div>
                        <input type="text" name="buildingExternalId" value="@buildingExternalId" class="form-control" placeholder="SR-BLD-069" />
                    </div>
                </div>
                <div class="col-xl-2 col-lg-6">
                    <div class="inventory-filter-fixed">
                        <div class="filter-title">Accion</div>
                        <input type="text" name="actionType" value="@actionType" class="form-control" placeholder="login-success" />
                    </div>
                </div>
                <div class="col-xl-2 col-lg-6">
                    <div class="inventory-filter-fixed">
                        <div class="filter-title">Recurso</div>
                        <input type="text" name="resource" value="@resource" class="form-control" placeholder="auth/login" />
                    </div>
                </div>
                <div class="col-xl-2 col-lg-6">
                    <div class="inventory-filter-fixed">
                        <div class="filter-title">Resultado</div>
                        <select name="result" class="form-select">
                            <option value="" selected="@(string.IsNullOrWhiteSpace(result))">Todos</option>
                            <option value="success" selected="@(result == "success")">Exito</option>
                            <option value="failure" selected="@(result == "failure")">Fallo</option>
                            <option value="challenge" selected="@(result == "challenge")">Pendiente</option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-2 col-lg-6">
                    <div class="inventory-filter-fixed">
                        <div class="filter-title">Severidad</div>
                        <select name="severity" class="form-select">
                            <option value="" selected="@(string.IsNullOrWhiteSpace(severity))">Todas</option>
                            <option value="info" selected="@(severity == "info")">Info</option>
                            <option value="warning" selected="@(severity == "warning")">Advertencia</option>
                            <option value="critical" selected="@(severity == "critical")">Critico</option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-6">
                    <div class="inventory-filter-fixed">
                        <div class="filter-title">Buscar texto</div>
                        <input type="text" name="search" value="@search" class="form-control" placeholder="IP, agente, resumen, detalle..." />
                    </div>
                </div>
                <div class="col-xl-2 col-lg-6">
                    <div class="inventory-filter-fixed">
                        <div class="filter-title">IP</div>
                        <input type="text" name="clientIp" value="@clientIp" class="form-control" placeholder="10.6.50.6" />
                    </div>
                </div>
                <div class="col-xl-4 col-lg-6">
                    <div class="inventory-filter-fixed">
                        <div class="filter-title">Agente</div>
                        <input type="text" name="userAgent" value="@userAgent" class="form-control" placeholder="Chrome..." />
                    </div>
                </div>
                <div class="col-xl-2 col-lg-6">
                    <div class="inventory-filter-fixed">
                        <div class="filter-title">Desde</div>
                        <input type="date" name="from" value="@dateFrom" class="form-control" />
                    </div>
                </div>
                <div class="col-xl-2 col-lg-6">
                    <div class="inventory-filter-fixed">
                        <div class="filter-title">Hasta</div>
                        <input type="date" name="to" value="@dateTo" class="form-control" />
                    </div>
                </div>
                <div class="col-xl-2 col-lg-4">
                    <div class="inventory-filter-fixed">
                        <div class="filter-title">Por pagina</div>
                        <select name="pageSize" class="form-select js-page-size-select">
                            <option value="30" selected="@(pageSize == 30)">30</option>
                            <option value="50" selected="@(pageSize == 50)">50</option>
                            <option value="100" selected="@(pageSize == 100)">100</option>
                            <option value="200" selected="@(pageSize == 200)">200</option>
                            <option value="500" selected="@(pageSize == 500)">500</option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-8">
                    <div class="inventory-filter-fixed">
                        <div class="filter-title">Acciones</div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-outline-primary flex-grow-1">
                                <i class="bi bi-funnel me-1"></i> Filtrar
                            </button>
                            <a href="/admin/activity" class="btn btn-secondary" title="Limpiar filtros" aria-label="Limpiar filtros">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </form>

    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Usuario</th>
                        <th>Accion</th>
                        <th>Recurso</th>
                        <th>Resultado</th>
                        <th>Severidad</th>
                        <th>Edificio</th>
                        <th>Resumen</th>
                        <th>Previo</th>
                        <th>Nuevo</th>
                        <th>IP</th>
                        <th>Agente</th>
                    </tr>
                </thead>
                <tbody>
                    @if (items.Count == 0)
                    {
                        <tr>
                            <td colspan="12" class="text-center text-muted py-4">No hay registros para ese filtro.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in items)
                        {
                            <tr>
                                <td class="small text-nowrap">@(DateTime.TryParse(GetItemString(item, "CreatedAtUtc"), out var createdAt) ? createdAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") : "")</td>
                                <td class="small">@GetItemString(item, "ChangedByUsername")</td>
                                <td><span class="badge bg-secondary">@GetItemString(item, "ActionType")</span></td>
                                <td class="small">@GetItemString(item, "Resource")</td>
                                <td class="small">
                                    @{
                                        var itemResult = GetItemString(item, "Result");
                                        var itemSeverity = GetItemString(item, "Severity");
                                    }
                                    <span class="badge @(itemResult == "failure" ? "bg-danger" : itemResult == "challenge" ? "bg-warning text-dark" : "bg-success")">
                                        @itemResult
                                    </span>
                                </td>
                                <td class="small">
                                    <span class="badge @(itemSeverity == "critical" ? "bg-danger" : itemSeverity == "warning" ? "bg-warning text-dark" : "bg-info text-dark")">
                                        @itemSeverity
                                    </span>
                                </td>
                                <td class="small">@GetItemString(item, "BuildingExternalId")</td>
                                <td class="small">@GetItemString(item, "Summary")</td>
                                <td class="small text-muted">@GetItemString(item, "PreviousValue")</td>
                                <td class="small text-muted">@GetItemString(item, "NewValue")</td>
                                <td class="small text-nowrap">@GetItemString(item, "ClientIp")</td>
                                <td class="small text-muted">@GetItemString(item, "UserAgent")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="small text-muted">
        Pagina @(page) de @Math.Max(1, totalPages) | Mostrando @items.Count de @totalCount registros
    </div>
    <div class="d-flex gap-2">
        @if (page > 1)
        {
            <a class="btn btn-outline-secondary btn-sm" href="@BuildActivityUrl(page - 1)">
                <i class="bi bi-chevron-left"></i> Anterior
            </a>
        }
        @if (page < totalPages)
        {
            <a class="btn btn-outline-secondary btn-sm" href="@BuildActivityUrl(page + 1)">
                Siguiente <i class="bi bi-chevron-right"></i>
            </a>
        }
    </div>
</div>

<script>
window.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll(".js-page-size-select").forEach((select) => {
    select.addEventListener("change", () => {
      const form = select.closest("form");
      if (!form) {
        return;
      }

      if (typeof form.requestSubmit === "function") {
        form.requestSubmit();
      } else {
        form.submit();
      }
    });
  });
});
</script>
