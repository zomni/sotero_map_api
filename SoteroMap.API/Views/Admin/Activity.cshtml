@model SoteroMap.API.ViewModels.AdminActivityViewModel
@{
    ViewData["Title"] = "Auditoria";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var activeFilters = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.BuildingExternalId)) { activeFilters.Add($"Edificio: {Model.BuildingExternalId}"); }
    if (!string.IsNullOrWhiteSpace(Model.ChangedByUsername)) { activeFilters.Add($"Usuario: {Model.ChangedByUsername}"); }
    if (!string.IsNullOrWhiteSpace(Model.ActionType)) { activeFilters.Add($"Accion: {Model.ActionType}"); }
    if (!string.IsNullOrWhiteSpace(Model.Resource)) { activeFilters.Add($"Recurso: {Model.Resource}"); }
    if (!string.IsNullOrWhiteSpace(Model.Result)) { activeFilters.Add($"Resultado: {Model.Result}"); }
    if (!string.IsNullOrWhiteSpace(Model.Severity)) { activeFilters.Add($"Severidad: {Model.Severity}"); }
    if (!string.IsNullOrWhiteSpace(Model.Search)) { activeFilters.Add($"Texto: {Model.Search}"); }
    if (!string.IsNullOrWhiteSpace(Model.ClientIp)) { activeFilters.Add($"IP: {Model.ClientIp}"); }
    if (!string.IsNullOrWhiteSpace(Model.UserAgent)) { activeFilters.Add($"Agente: {Model.UserAgent}"); }
    if (!string.IsNullOrWhiteSpace(Model.DateFrom)) { activeFilters.Add($"Desde: {Model.DateFrom}"); }
    if (!string.IsNullOrWhiteSpace(Model.DateTo)) { activeFilters.Add($"Hasta: {Model.DateTo}"); }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Auditoria formal</h2>
        <div class="text-muted">Eventos sensibles con usuario, IP, agente, resultado y valores previos/nuevos.</div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Usuario</label>
                <input type="text" name="changedByUsername" value="@Model.ChangedByUsername" class="form-control" placeholder="admin" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Edificio</label>
                <input type="text" name="buildingExternalId" value="@Model.BuildingExternalId" class="form-control" placeholder="SR-BLD-069" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Accion</label>
                <input type="text" name="actionType" value="@Model.ActionType" class="form-control" placeholder="login-success" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Recurso</label>
                <input type="text" name="resource" value="@Model.Resource" class="form-control" placeholder="auth/login" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Resultado</label>
                <select name="result" class="form-select">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Result))">Todos</option>
                    <option value="success" selected="@(Model.Result == "success")">Exito</option>
                    <option value="failure" selected="@(Model.Result == "failure")">Fallo</option>
                    <option value="challenge" selected="@(Model.Result == "challenge")">Pendiente</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Severidad</label>
                <select name="severity" class="form-select">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Severity))">Todas</option>
                    <option value="info" selected="@(Model.Severity == "info")">Info</option>
                    <option value="warning" selected="@(Model.Severity == "warning")">Advertencia</option>
                    <option value="critical" selected="@(Model.Severity == "critical")">Critico</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Buscar texto</label>
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="IP, agente, resumen, detalle..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">IP</label>
                <input type="text" name="clientIp" value="@Model.ClientIp" class="form-control" placeholder="10.6.50.6" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Agente</label>
                <input type="text" name="userAgent" value="@Model.UserAgent" class="form-control" placeholder="Chrome..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Desde</label>
                <input type="date" name="from" value="@Model.DateFrom" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Hasta</label>
                <input type="date" name="to" value="@Model.DateTo" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Por pagina</label>
                <select name="pageSize" class="form-select">
                    <option value="30" selected="@(Model.PageSize == 30)">30</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    <option value="100" selected="@(Model.PageSize == 100)">100</option>
                    <option value="200" selected="@(Model.PageSize == 200)">200</option>
                    <option value="500" selected="@(Model.PageSize == 500)">500</option>
                </select>
            </div>
            <div class="col-md-12">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-funnel me-1"></i> Filtrar
                    </button>
                    <a href="/admin/activity" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i> Limpiar
                    </a>
                </div>
            </div>
        </form>

        <div class="mt-3">
            <div class="small text-muted mb-2">Filtros aplicados (@activeFilters.Count)</div>
            @if (activeFilters.Count > 0)
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var filter in activeFilters)
                    {
                        <span class="badge rounded-pill text-bg-light border">@filter</span>
                    }
                </div>
            }
            else
            {
                <div class="small text-muted">Sin filtros adicionales aplicados.</div>
            }
        </div>

        <div class="row g-3 mt-3">
            <div class="col-md-3">
                <div class="p-3 rounded-3 bg-light border">
                    <div class="text-muted small">Total encontrados</div>
                    <div class="fs-4 fw-bold">@Model.TotalCount</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 rounded-3 bg-light border">
                    <div class="text-muted small">Exitos</div>
                    <div class="fs-4 fw-bold">@Model.SuccessCount</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 rounded-3 bg-light border">
                    <div class="text-muted small">Fallos</div>
                    <div class="fs-4 fw-bold">@Model.FailureCount</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 rounded-3 bg-light border">
                    <div class="text-muted small">Criticos</div>
                    <div class="fs-4 fw-bold">@Model.CriticalCount</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Usuario</th>
                        <th>Accion</th>
                        <th>Recurso</th>
                        <th>Resultado</th>
                        <th>Severidad</th>
                        <th>Edificio</th>
                        <th>Resumen</th>
                        <th>Previo</th>
                        <th>Nuevo</th>
                        <th>IP</th>
                        <th>Agente</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="12" class="text-center text-muted py-4">No hay registros para ese filtro.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="small text-nowrap">@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td class="small">@item.ChangedByUsername</td>
                                <td><span class="badge bg-secondary">@item.ActionType</span></td>
                                <td class="small">@item.Resource</td>
                                <td class="small">
                                    <span class="badge @(item.Result == "failure" ? "bg-danger" : item.Result == "challenge" ? "bg-warning text-dark" : "bg-success")">
                                        @item.Result
                                    </span>
                                </td>
                                <td class="small">
                                    <span class="badge @(item.Severity == "critical" ? "bg-danger" : item.Severity == "warning" ? "bg-warning text-dark" : "bg-info text-dark")">
                                        @item.Severity
                                    </span>
                                </td>
                                <td class="small">@item.BuildingExternalId</td>
                                <td class="small">@item.Summary</td>
                                <td class="small text-muted">@item.PreviousValue</td>
                                <td class="small text-muted">@item.NewValue</td>
                                <td class="small text-nowrap">@item.ClientIp</td>
                                <td class="small text-muted">@item.UserAgent</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-3">
    <div class="small text-muted">
        Pagina @Model.Page de @Math.Max(1, Model.TotalPages) | Mostrando @Model.Items.Count de @Model.TotalCount registros
    </div>
    <div class="d-flex gap-2">
        @if (Model.Page > 1)
        {
            <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Activity", new {
                buildingExternalId = Model.BuildingExternalId,
                changedByUsername = Model.ChangedByUsername,
                actionType = Model.ActionType,
                resource = Model.Resource,
                result = Model.Result,
                severity = Model.Severity,
                search = Model.Search,
                clientIp = Model.ClientIp,
                userAgent = Model.UserAgent,
                from = Model.DateFrom,
                to = Model.DateTo,
                page = Model.Page - 1,
                pageSize = Model.PageSize
            })">
                <i class="bi bi-chevron-left"></i> Anterior
            </a>
        }
        @if (Model.Page < Model.TotalPages)
        {
            <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Activity", new {
                buildingExternalId = Model.BuildingExternalId,
                changedByUsername = Model.ChangedByUsername,
                actionType = Model.ActionType,
                resource = Model.Resource,
                result = Model.Result,
                severity = Model.Severity,
                search = Model.Search,
                clientIp = Model.ClientIp,
                userAgent = Model.UserAgent,
                from = Model.DateFrom,
                to = Model.DateTo,
                page = Model.Page + 1,
                pageSize = Model.PageSize
            })">
                Siguiente <i class="bi bi-chevron-right"></i>
            </a>
        }
    </div>
</div>
