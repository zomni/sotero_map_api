@{
    ViewData["Title"] = "Cumplimiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic compliance = ViewData.Model;
    var overallStatus = (string)(compliance.OverallStatus ?? "Advertencia");
    var statusClass = overallStatus switch
    {
        "OK" => "bg-success",
        "Critico" => "bg-danger",
        _ => "bg-warning text-dark"
    };
    var overallLabel = (string)(compliance.OverallStatusLabel ?? overallStatus);
}

<style>
    .compliance-hero {
        border: 0;
        border-radius: 22px;
        color: #fff;
        background:
            radial-gradient(circle at top right, rgba(59, 130, 246, 0.22), transparent 32%),
            linear-gradient(135deg, #0f172a 0%, #1d4ed8 55%, #38bdf8 100%);
    }
    .compliance-card { border: 0; border-radius: 18px; box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08); }
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .45rem .8rem;
        border-radius: 999px;
        font-weight: 700;
    }
    .status-ok { background: rgba(34, 197, 94, .12); color: #15803d; }
    .status-warning { background: rgba(245, 158, 11, .14); color: #b45309; }
    .status-critical { background: rgba(239, 68, 68, .12); color: #b91c1c; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Panel de cumplimiento</h2>
        <div class="text-muted">Resumen SGSI: backups, accesos, MFA, HTTPS, Swagger y LDAPS.</div>
    </div>
    <span class="status-pill @(statusClass == "bg-success" ? "status-ok" : statusClass == "bg-danger" ? "status-critical" : "status-warning")">
        <i class="bi bi-circle-fill small"></i>@overallLabel
    </span>
</div>

<div class="card compliance-hero shadow-sm mb-4">
    <div class="card-body p-4 p-lg-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-7">
                <div class="text-uppercase small fw-semibold text-white-50 mb-2">Estado global</div>
                <h1 class="fw-bold mb-3">Semaforo de cumplimiento institucional</h1>
                <p class="text-white-50 mb-4">
                    El panel consolida los controles clave de la plataforma y te muestra si el entorno esta listo para uso interno.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="status-pill status-ok"><i class="bi bi-check-circle"></i>OK</span>
                    <span class="status-pill status-warning"><i class="bi bi-exclamation-circle"></i>Advertencia</span>
                    <span class="status-pill status-critical"><i class="bi bi-x-circle"></i>Critico</span>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="bg-white bg-opacity-10 rounded-4 p-4">
                    <div class="row g-3 text-center">
                        @foreach (var card in compliance.SummaryCards)
                        {
                            <div class="col-6">
                                <div class="rounded-4 bg-white bg-opacity-10 p-3 h-100">
                                    <i class="@card.IconClass fs-3 d-block mb-2"></i>
                                    <div class="small text-white-50">@card.Title</div>
                                    <div class="fs-3 fw-bold">@card.Value</div>
                                    <div class="small text-white-50">@card.Detail</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    @foreach (var check in compliance.Checks)
    {
        var checkClass = check.Status switch
        {
            "ok" => "text-bg-success",
            "critical" => "text-bg-danger",
            _ => "text-bg-warning"
        };
        <div class="col-md-6 col-xl-4">
            <div class="card compliance-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-3">
                        <div class="dashboard-kpi-icon bg-primary bg-opacity-10">
                            <i class="@check.IconClass text-primary fs-4"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div class="fw-semibold">@check.Title</div>
                                <span class="badge @checkClass">@check.Status</span>
                            </div>
                            <div class="text-muted small">@check.Detail</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card compliance-card h-100">
            <div class="card-header bg-white fw-semibold">Ultimos respaldos</div>
            <div class="card-body">
                @if (compliance.RecentBackups.Count == 0)
                {
                    <div class="text-muted small">Todavia no hay respaldos en el historial.</div>
                }
                else
                {
                    <div class="d-grid gap-3">
                        @foreach (var item in compliance.RecentBackups)
                        {
                            <div class="border rounded-3 p-3">
                                <div class="d-flex justify-content-between gap-2">
                                    <div class="fw-semibold small">@item.Title</div>
                                    <span class="badge @item.BadgeClass">@item.Badge</span>
                                </div>
                                <div class="small text-muted mt-1">@item.Detail</div>
                                <div class="small text-muted">@item.TimeLabel</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card compliance-card h-100">
            <div class="card-header bg-white fw-semibold">Ultimos accesos</div>
            <div class="card-body">
                @if (compliance.RecentAccesses.Count == 0)
                {
                    <div class="text-muted small">Todavia no hay accesos recientes auditados.</div>
                }
                else
                {
                    <div class="d-grid gap-3">
                        @foreach (var item in compliance.RecentAccesses)
                        {
                            <div class="border rounded-3 p-3">
                                <div class="d-flex justify-content-between gap-2">
                                    <div class="fw-semibold small">@item.Title</div>
                                    <span class="badge @item.BadgeClass">@item.Badge</span>
                                </div>
                                <div class="small text-muted mt-1">@item.Detail</div>
                                <div class="small text-muted">@item.TimeLabel</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card compliance-card h-100">
            <div class="card-header bg-white fw-semibold">Eventos criticos</div>
            <div class="card-body">
                @if (compliance.CriticalEvents.Count == 0)
                {
                    <div class="text-muted small">No hay eventos criticos recientes.</div>
                }
                else
                {
                    <div class="d-grid gap-3">
                        @foreach (var item in compliance.CriticalEvents)
                        {
                            <div class="border rounded-3 p-3">
                                <div class="d-flex justify-content-between gap-2">
                                    <div class="fw-semibold small">@item.Title</div>
                                    <span class="badge @item.BadgeClass">@item.Badge</span>
                                </div>
                                <div class="small text-muted mt-1">@item.Detail</div>
                                <div class="small text-muted">@item.TimeLabel</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="card compliance-card h-100">
            <div class="card-header bg-white fw-semibold">Resumen de salud</div>
            <div class="card-body">
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">Base de datos</span><strong>@(compliance.DatabaseConnected ? "OK" : "Critico")</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">HTTPS</span><strong>@(compliance.HttpsConfigured ? "Configurado" : "Advertencia")</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">Swagger</span><strong>@(compliance.SwaggerRestricted ? "Restringido" : "Advertencia")</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">MFA Admin</span><strong>@(compliance.MfaCompliant ? "OK" : "Critico")</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">Backup</span><strong>@(compliance.BackupEnabled ? (compliance.BackupHealthy ? "OK" : "Advertencia") : "Deshabilitado")</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted">LDAPS</span><strong>@(compliance.LdapsConfigured ? "OK" : "Advertencia")</strong></div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card compliance-card h-100">
            <div class="card-header bg-white fw-semibold">Datos de sistema</div>
            <div class="card-body">
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">Usuarios activos</span><strong>@compliance.ActiveUsers</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">Administradores</span><strong>@compliance.AdminUsers</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">Fallos login 7 dias</span><strong>@compliance.FailedLoginsLast7Days</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">Criticos 7 dias</span><strong>@compliance.CriticalEventsLast7Days</strong></div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2"><span class="text-muted">BDD</span><strong>@compliance.DatabaseFileName</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted">Ultima modificacion</span><strong>@(compliance.DatabaseLastWriteUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Sin datos")</strong></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-12">
        <div class="card compliance-card h-100">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center gap-2">
                <span>Integridad tecnica</span>
                <span id="integrity-status-pill" class="status-pill status-warning"><i class="bi bi-hourglass-split"></i>Cargando</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="text-muted small">Estado general</div>
                            <div id="integrity-status" class="fw-bold">Cargando...</div>
                            <div id="integrity-updated-at" class="text-muted small mt-1"></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="text-muted small">Equipos</div>
                            <div id="integrity-equipment-count" class="fs-4 fw-bold">-</div>
                            <div class="text-muted small">Inventario total detectado</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="text-muted small">Admins activos</div>
                            <div id="integrity-admin-count" class="fs-4 fw-bold">-</div>
                            <div id="integrity-mfa-text" class="text-muted small mt-1"></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="text-muted small">Backup / PDF</div>
                            <div id="integrity-backup-text" class="fw-semibold">-</div>
                            <div id="integrity-pdf-text" class="text-muted small mt-1"></div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="border rounded-3 p-3">
                            <div class="text-muted small mb-2">Tablas criticas</div>
                            <div id="integrity-tables" class="d-flex flex-wrap gap-2"></div>
                            <div id="integrity-missing" class="small text-muted mt-2"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
window.addEventListener("DOMContentLoaded", () => {
    const statusPill = document.getElementById("integrity-status-pill");
    const statusText = document.getElementById("integrity-status");
    const updatedAt = document.getElementById("integrity-updated-at");
    const equipmentCount = document.getElementById("integrity-equipment-count");
    const adminCount = document.getElementById("integrity-admin-count");
    const mfaText = document.getElementById("integrity-mfa-text");
    const backupText = document.getElementById("integrity-backup-text");
    const pdfText = document.getElementById("integrity-pdf-text");
    const tables = document.getElementById("integrity-tables");
    const missing = document.getElementById("integrity-missing");

    const setPill = (status) => {
        if (!statusPill) return;
        const normalized = (status || "").toLowerCase();
        const map = {
            "ok": ["status-ok", "bi-check-circle", "OK"],
            "critical": ["status-critical", "bi-x-circle", "Crítico"],
            "advertencia": ["status-warning", "bi-exclamation-circle", "Advertencia"]
        };
        const selected = map[normalized] || map["advertencia"];
        statusPill.className = `status-pill ${selected[0]}`;
        statusPill.innerHTML = `<i class="bi ${selected[1]}"></i>${selected[2]}`;
    };

    fetch("/api/health/integrity", { credentials: "same-origin", cache: "no-store" })
        .then(async (response) => {
            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }
            return response.json();
        })
        .then((data) => {
            setPill(data.status);
            if (statusText) {
                statusText.textContent = data.status || "Advertencia";
            }
            if (updatedAt) {
                updatedAt.textContent = data.generatedAtUtc ? `Actualizado: ${new Date(data.generatedAtUtc).toLocaleString()}` : "";
            }
            if (equipmentCount) {
                equipmentCount.textContent = data.equipmentCount ?? "-";
            }
            if (adminCount) {
                adminCount.textContent = data.activeAdmins ?? "-";
            }
            if (mfaText) {
                mfaText.textContent = data.mfaCompliant ? "MFA admin OK" : `MFA pendiente en ${Math.max(0, (data.activeAdmins || 0) - (data.adminUsersWithMfa || 0))} admin(s)`;
            }
            if (backupText) {
                backupText.textContent = data.backupHealthy ? "Backup reciente OK" : "Backup requiere revision";
            }
            if (pdfText) {
                const maxMb = data.pdfMaxBytes ? (data.pdfMaxBytes / 1024 / 1024).toFixed(0) : "-";
                pdfText.textContent = `PDF maximo permitido: ${maxMb} MB`;
            }
            if (tables) {
                const required = Array.isArray(data.requiredTables) ? data.requiredTables : [];
                tables.innerHTML = required.map((table) => `<span class="badge text-bg-light border">${table}</span>`).join("");
            }
            if (missing) {
                const missingTables = Array.isArray(data.missingTables) ? data.missingTables : [];
                missing.textContent = missingTables.length > 0
                    ? `Faltan: ${missingTables.join(", ")}`
                    : "Todas las tablas criticas estan presentes.";
            }
        })
        .catch((error) => {
            setPill("critical");
            if (statusText) {
                statusText.textContent = "No se pudo cargar la integridad";
            }
            if (updatedAt) {
                updatedAt.textContent = error?.message || "";
            }
            if (missing) {
                missing.textContent = "La consulta de integridad fallo.";
            }
        });
});
</script>
}
