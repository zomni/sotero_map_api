@if (User.IsInRole(SoteroMap.API.Models.AppRoles.Admin) || User.IsInRole(SoteroMap.API.Models.AppRoles.Auditor))
{
    <div class="telemetry-scan-modal" id="networkTelemetryScanModal" aria-labelledby="networkTelemetryScanModalLabel" aria-hidden="true">
        <div class="telemetry-scan-dialog">
            <div class="modal-content telemetry-scan-card border-0 shadow">
                <div class="modal-header">
                    <div>
                        <div class="text-uppercase small fw-semibold text-muted mb-1">Agente Windows</div>
                        <h5 class="modal-title mb-0" id="networkTelemetryScanModalLabel">Escaneo vivo de red</h5>
                    </div>
                    <button type="button" class="btn-close" id="network-telemetry-close-scan" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="telemetry-scan-intro mb-3">
                        Este boton enviara una solicitud al agente Windows. Ese agente es el que debe capturar los usuarios reales de sesion,
                        hostname, fabricante, modelo y datos Windows del equipo.
                    </div>
                    <div class="telemetry-scan-section mb-3">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" role="switch" id="telemetryResolveSessions" checked />
                            <label class="form-check-label fw-semibold" for="telemetryResolveSessions">Intentar capturar sesion activa del equipo</label>
                        </div>
                            <div class="form-text">
                                Intenta resolver el usuario o sesion activa del equipo ademas del resto de datos observados.
                            </div>
                    </div>
                    <div class="telemetry-scan-section mb-3">
                        <label class="form-label fw-semibold" for="telemetryScanMode">Modo de escaneo</label>
                        <select class="form-select" id="telemetryScanMode">
                            <option value="simple" selected>Simple: usuario/sesion, IP y host. Mas rapido.</option>
                            <option value="full">Completo: agrega puertos, perfil y enriquecimiento extendido.</option>
                        </select>
                        <div class="form-text mt-2">
                            Usa <strong>Simple</strong> para obtener usuarios activos mas rapido. Usa <strong>Completo</strong> cuando quieras
                            enriquecer el snapshot con mas detalles tecnicos.
                        </div>
                    </div>
                    <div class="telemetry-scan-note mb-3">
                        Recomendado: instala el agente una sola vez con
                        <code>.\tools\install-network-collector-agent.ps1</code>
                        y luego usa solo este boton desde el dashboard.
                    </div>
                    <div id="telemetry-scan-feedback" class="small text-muted mt-3"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" id="network-telemetry-cancel-scan">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="network-telemetry-confirm-scan">
                        <i class="bi bi-radar me-1"></i> Iniciar escaneo
                    </button>
                </div>
            </div>
        </div>
    </div>
}

