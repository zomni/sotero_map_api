@using System.Text.Json
@using System.Text.Json.Serialization
@model SoteroMap.API.ViewModels.NetworkTelemetryDashboardViewModel
@{
    ViewData["Title"] = "Red y riesgo";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var telemetryJsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web)
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };
}

@functions {
    string FormatChileTime(DateTime? utcValue, string format = "dd/MM/yyyy HH:mm")
    {
        if (utcValue == null) return "-";
        try
        {
            var tz = TimeZoneInfo.FindSystemTimeZoneById("America/Santiago");
            return TimeZoneInfo.ConvertTimeFromUtc(utcValue.Value, tz).ToString(format);
        }
        catch
        {
            return utcValue.Value.ToLocalTime().ToString(format);
        }
    }
}

<style>
    .telemetry-hero {
        border: 0;
        border-radius: 22px;
        background:
            radial-gradient(circle at top right, rgba(14, 165, 233, 0.18), transparent 34%),
            linear-gradient(135deg, #0f172a 0%, #1f3b57 52%, #184e77 100%);
        color: #fff;
        overflow: hidden;
    }

    .telemetry-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
        transition: transform .28s ease, box-shadow .28s ease;
    }
    .telemetry-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.14);
    }
    .telemetry-card-static {
        transition: none !important;
    }
    .telemetry-card-static:hover {
        transform: none !important;
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08) !important;
    }
    .telemetry-card .card-header {
        border-bottom: 1px solid rgba(226, 232, 240, 0.7);
        padding: 1rem 1.25rem;
        position: relative;
    }
    .telemetry-card .card-header::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        border-radius: 0 4px 4px 0;
        background: linear-gradient(180deg, #2d79a0, #38bdf8);
    }
    .telemetry-kpi {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        transition: transform .3s ease, box-shadow .3s ease;
    }
    .telemetry-card:hover .telemetry-kpi {
        transform: scale(1.08);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
    }

    .telemetry-scan-modal {
        position: fixed;
        inset: 0;
        z-index: 2100;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(15, 23, 42, 0.5);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
    }

    .telemetry-scan-modal.is-open {
        display: flex;
    }

    .telemetry-scan-dialog {
        width: min(640px, 100%);
        max-height: calc(100vh - 40px);
        overflow: auto;
    }

    .telemetry-scan-card {
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 24px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 28px 60px rgba(15, 23, 42, 0.28);
    }

    .telemetry-scan-card .modal-header {
        border-bottom: 1px solid rgba(226, 232, 240, 0.9);
        background:
            radial-gradient(circle at top right, rgba(14, 165, 233, 0.12), transparent 38%),
            linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
        padding: 20px 24px;
    }

    .telemetry-scan-card .modal-body {
        padding: 24px;
        background: #ffffff;
    }

    .telemetry-scan-card .modal-footer {
        border-top: 1px solid rgba(226, 232, 240, 0.9);
        background: #f8fafc;
        padding: 16px 24px 20px;
    }

    .telemetry-scan-intro {
        border: 1px solid rgba(125, 211, 252, 0.35);
        border-radius: 18px;
        background: linear-gradient(180deg, #eff8ff 0%, #f8fbff 100%);
        color: #0f172a;
        padding: 16px 18px;
    }

    .telemetry-scan-section {
        border: 1px solid rgba(226, 232, 240, 0.9);
        border-radius: 18px;
        background: #ffffff;
        padding: 16px 18px;
    }

    .telemetry-scan-note {
        border-radius: 14px;
        background: #f8fafc;
        color: #475569;
        padding: 12px 14px;
    }

    .telemetry-filter-panel {
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 18px;
        background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
    }

    .telemetry-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid rgba(148, 163, 184, 0.25);
        background: #fff;
        color: #334155;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .telemetry-chip button {
        border: 0;
        background: transparent;
        color: inherit;
        padding: 0;
        line-height: 1;
    }

    .telemetry-mini-stat {
        border-radius: 16px;
        background: #f8fafc;
        border: 1px solid rgba(148, 163, 184, 0.16);
        padding: 16px;
    }

    .telemetry-table-wrap {
        border: 1px solid rgba(148, 163, 184, 0.16);
        border-radius: 16px;
        overflow: hidden;
    }

    .telemetry-table-wrap table {
        margin-bottom: 0;
    }

    .telemetry-table-wrap thead th {
        background: #f8fafc;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #64748b;
        vertical-align: middle;
        white-space: nowrap;
    }

    .telemetry-sort-button {
        border: 0;
        background: transparent;
        padding: 0;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: inherit;
        font: inherit;
        text-transform: inherit;
        letter-spacing: inherit;
        white-space: nowrap;
    }

    .telemetry-sort-button i {
        font-size: 0.75rem;
        color: #94a3b8;
    }

    .telemetry-sort-button.is-active i {
        color: #0f766e;
    }

    .telemetry-table-wrap tbody tr:hover {
        background: rgba(14, 165, 233, 0.05);
    }

    #telemetry-device-table {
        min-height: 420px;
    }

    .telemetry-loading-shell {
        min-height: 420px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(148, 163, 184, 0.16);
        border-radius: 16px;
        background: linear-gradient(180deg, #fbfdff 0%, #f8fafc 100%);
    }

    .telemetry-loading-content {
        display: grid;
        gap: 10px;
        justify-items: center;
        text-align: center;
        color: #64748b;
    }

    .telemetry-pill {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .telemetry-pill.telemetry-pill-critical { background: #fee2e2; color: #b91c1c; }
    .telemetry-pill.telemetry-pill-high { background: #ffedd5; color: #c2410c; }
    .telemetry-pill.telemetry-pill-medium { background: #fef3c7; color: #a16207; }
    .telemetry-pill.telemetry-pill-low { background: #dcfce7; color: #15803d; }
    .telemetry-pill.telemetry-pill-unknown { background: #e2e8f0; color: #475569; }

    .telemetry-inline-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .telemetry-clickable-row {
        cursor: pointer;
    }

    .telemetry-row-active {
        background: rgba(59, 130, 246, 0.08);
    }

    .telemetry-help {
        width: 1.7rem;
        height: 1.7rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        border: 1px solid rgba(148, 163, 184, 0.25);
        color: #64748b;
        background: #fff;
        font-size: 0.8rem;
    }

    .fade-in-up {
        animation: fadeUp .5s ease both;
    }
    .fade-in-up-d1 { animation-delay: .05s; }
    .fade-in-up-d2 { animation-delay: .1s; }
    .fade-in-up-d3 { animation-delay: .15s; }
    .fade-in-up-d4 { animation-delay: .2s; }
    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(18px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .telemetry-agent-shell {
        display: grid;
        gap: 10px;
        margin-top: 14px;
        padding: 14px 16px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.14);
    }

    .telemetry-agent-top {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
    }

    .telemetry-agent-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .telemetry-agent-stat {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        color: rgba(255, 255, 255, 0.9);
        font-size: 0.8rem;
    }

    .telemetry-progress {
        height: 8px;
        width: 100%;
        border-radius: 999px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.12);
    }

    .telemetry-progress > span {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #38bdf8 0%, #facc15 100%);
    }

    .telemetry-fixed-grid {
        display: grid;
        gap: 16px;
        grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    }

    @@media (max-width: 1199px) {
        .telemetry-fixed-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Red y riesgo</h2>
    <span class="text-muted">Inventario tecnico observado por red</span>
</div>

@if (Model.ActiveSnapshotId > 0)
{
    var triggerLabel = Model.LatestSourceType switch
    {
        "scheduled" => "Programado",
        "automatic" => "Automatico",
        "manual" => "Manual",
        _ => Model.LatestSourceType
    };
    <div class="d-flex flex-wrap align-items-center gap-2 py-3 px-4 mb-4 rounded-4 border"
         style="background: linear-gradient(135deg, #f0f4fe 0%, #e8eefa 100%);">
        <div class="d-flex align-items-center gap-2 me-3">
            <span class="badge bg-primary bg-opacity-75 rounded-pill fs-6 fw-semibold px-3 py-2">
                <i class="bi bi-camera-fill me-1"></i>
                @(Model.IsViewingLatestSnapshot ? "Ultima snapshot" : $"Snapshot #{Model.ActiveSnapshotId}")
            </span>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3 small">
            <span class="d-inline-flex align-items-center gap-1 text-secondary">
                <i class="bi bi-broadcast text-primary"></i>
                @Model.LatestSourceName@(string.IsNullOrWhiteSpace(triggerLabel) ? "" : $" ({triggerLabel})")
            </span>
            <span class="text-secondary fw-lighter">|</span>
            <span class="d-inline-flex align-items-center gap-1 text-secondary">
                <i class="bi bi-calendar3 text-primary"></i>
                @FormatChileTime(Model.LatestObservedAtUtc)
            </span>
            <span class="text-secondary fw-lighter">|</span>
            <span class="d-inline-flex align-items-center gap-1 text-secondary">
                <i class="bi bi-hash text-primary"></i>
                #@Model.ActiveSnapshotId
            </span>
        </div>
        @if (!Model.IsViewingLatestSnapshot && Model.LatestSnapshotId > 0)
        {
            <a href="/dashboard/network-telemetry" class="btn btn-sm btn-outline-primary ms-auto rounded-pill">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Volver a la ultima
            </a>
        }
    </div>
}

<div id="telemetry-scan-running-banner" class="d-none mb-4">
    <div class="alert alert-info d-flex align-items-center gap-3 py-3 px-4 rounded-4 border-0 mb-0 shadow-sm"
         style="background: linear-gradient(135deg, #f0f9ff, #e0f2fe);">
        <div class="spinner-border text-primary" role="status" aria-hidden="true" style="width:1.5rem;height:1.5rem;"></div>
        <div class="fw-semibold text-primary-emphasis flex-grow-1">
            <span id="telemetry-scan-running-text">Escaneo en curso...</span>
            <small class="d-block text-secondary fw-normal mt-1" id="telemetry-scan-running-detail"></small>
        </div>
        <div style="width:120px;">
            <div class="progress" style="height:6px;" role="progressbar">
                <div id="telemetry-scan-running-progress" class="progress-bar progress-bar-striped progress-bar-animated"
                     style="width:0%;background:linear-gradient(90deg,#38bdf8,#facc15);"></div>
            </div>
            <small class="text-muted" id="telemetry-scan-running-pct">0%</small>
        </div>
    </div>
</div>

<div class="card telemetry-hero shadow-sm mb-4">
    <div class="card-body p-4 p-lg-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-7">
                <div class="text-uppercase small fw-semibold text-muted mb-2">Estado del modulo</div>
                <h1 class="fw-bold mb-3">@Model.HealthLabel</h1>
                <div class="d-flex flex-wrap gap-2">
                    @if (User.IsInRole(SoteroMap.API.Models.AppRoles.Admin) || User.IsInRole(SoteroMap.API.Models.AppRoles.Auditor))
                    {
                        <a href="/admin/compliance" class="btn btn-light fw-semibold">
                            <i class="bi bi-shield-check me-1"></i> Ver cumplimiento
                        </a>
                    }
                    @if (User.IsInRole(SoteroMap.API.Models.AppRoles.Admin) || User.IsInRole(SoteroMap.API.Models.AppRoles.Auditor))
                    {
                        <button id="network-telemetry-scan" type="button" class="btn btn-warning fw-semibold">
                            <i class="bi bi-radar me-1"></i> Escanear ahora
                        </button>
                        <button id="network-telemetry-pause" type="button" class="btn btn-outline-light fw-semibold" disabled>
                            <i class="bi bi-pause-fill me-1"></i> Pausar
                        </button>
                        <button id="network-telemetry-resume" type="button" class="btn btn-outline-light fw-semibold" disabled>
                            <i class="bi bi-play-fill me-1"></i> Reanudar
                        </button>
                        <button id="network-telemetry-stop" type="button" class="btn btn-outline-danger fw-semibold" disabled>
                            <i class="bi bi-stop-fill me-1"></i> Detener
                        </button>
                    }
                    <a href="/dashboard" class="btn btn-outline-light fw-semibold">
                        <i class="bi bi-speedometer2 me-1"></i> Volver al dashboard
                    </a>
                    <button type="button" class="telemetry-help" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Muestra la ultima captura de red, sesiones detectadas, riesgo tecnico y el detalle operativo del agente Windows.">
                        <i class="bi bi-info-lg"></i>
                    </button>
                </div>
                <div id="network-telemetry-agent-state" class="small text-white-50 mt-3"></div>
            </div>
            <div class="col-lg-5">
                <div class="bg-white bg-opacity-10 rounded-4 p-4">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="d-inline-flex align-items-center justify-content-center rounded-2" style="width:28px;height:28px;background:rgba(255,255,255,0.15)">
                                    <i class="bi bi-collection" style="font-size:0.85rem"></i>
                                </span>
                                <span class="small text-white-50">Snapshots</span>
                            </div>
                            <div class="fs-3 fw-bold text-white ms-1">@Model.TotalSnapshots</div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="d-inline-flex align-items-center justify-content-center rounded-2" style="width:28px;height:28px;background:rgba(255,255,255,0.15)">
                                    <i class="bi bi-people" style="font-size:0.85rem"></i>
                                </span>
                                <span class="small text-white-50">Endpoints</span>
                            </div>
                            <div class="fs-3 fw-bold text-white ms-1">@Model.LatestConnectedUserCount</div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="d-inline-flex align-items-center justify-content-center rounded-2" style="width:28px;height:28px;background:rgba(255,255,255,0.15)">
                                    <i class="bi bi-pc-display" style="font-size:0.85rem"></i>
                                </span>
                                <span class="small text-white-50">Equipos</span>
                            </div>
                            <div class="fs-3 fw-bold text-white ms-1">@Model.LatestDeviceCount</div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="d-inline-flex align-items-center justify-content-center rounded-2 @(Model.LatestRiskScore > 0 ? "bg-warning bg-opacity-25" : "")" style="width:28px;height:28px;background:rgba(255,255,255,0.15)">
                                    <i class="bi bi-shield-exclamation" style="font-size:0.85rem;@(Model.LatestRiskScore > 0 ? "color:#ffc107" : "")"></i>
                                </span>
                                <span class="small text-white-50">Riesgo base</span>
                            </div>
                            <div class="fs-3 fw-bold @(Model.LatestRiskScore > 0 ? "text-warning" : "text-white") ms-1">@Model.LatestRiskScore</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4 fade-in-up fade-in-up-d1">
        <div class="card telemetry-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="telemetry-kpi bg-primary bg-opacity-10">
                    <i class="bi bi-broadcast text-primary fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Fuente</div>
                    <div class="fw-semibold">@((string.IsNullOrWhiteSpace(Model.LatestSourceName) ? "Sin fuente" : Model.LatestSourceName))</div>
                    <div class="small text-muted">@((string.IsNullOrWhiteSpace(Model.LatestSourceType) ? "Esperando colector" : Model.LatestSourceType))</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 fade-in-up fade-in-up-d2">
        <div class="card telemetry-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="telemetry-kpi bg-warning bg-opacity-10">
                    <i class="bi bi-exclamation-triangle text-warning fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Estado</div>
                    <div class="fw-semibold">@Model.LatestStatus</div>
                    <div class="small text-muted">Nivel @Model.LatestRiskLevel</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 fade-in-up fade-in-up-d3">
        <div class="card telemetry-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="telemetry-kpi bg-success bg-opacity-10">
                    <i class="bi bi-clock-history text-success fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Ultima captura</div>
                    <div class="fw-semibold">@FormatChileTime(Model.LatestObservedAtUtc)</div>
                    <div class="small @(Model.IsFresh ? "text-success" : "text-warning")">
                        @if (Model.LatestObservedAtUtc.HasValue)
                        {
                            var elapsed = DateTime.UtcNow - Model.LatestObservedAtUtc.Value;
                            var display = elapsed.TotalSeconds < 0 ? "Ahora"
                                : elapsed.TotalMinutes < 1 ? "Hace segundos"
                                : elapsed.TotalMinutes < 120 ? $"Hace {(int)elapsed.TotalMinutes} min"
                                : elapsed.TotalHours < 48 ? $"Hace {(int)elapsed.TotalHours} h {(int)elapsed.Minutes} min"
                                : $"Hace {(int)elapsed.TotalDays} d";
                            <span><i class="bi bi-@(Model.IsFresh ? "check-circle" : "exclamation-circle") me-1"></i>@display</span>
                        }
                        else
                        {
                            <span>Sin datos</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card telemetry-card mb-4 fade-in-up fade-in-up-d1">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Resumen de la ultima observacion</h5>
            <span class="badge bg-@Model.HealthTone">@Model.HealthLabel</span>
        </div>

        @if (!Model.HasData)
        {
            <div class="alert alert-secondary mb-0">
                Aun no existen snapshots de red. Cuando ingrese la primera captura, aqui se mostraran los equipos observados y su riesgo.
            </div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <div class="text-muted small">Equipos</div>
                        <div class="fs-4 fw-bold">@Model.LatestDeviceCount</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <div class="text-muted small">Usuarios</div>
                        <div class="fs-4 fw-bold">@Model.LatestConnectedUserCount</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <div class="text-muted small">Altos y criticos</div>
                        <div class="fs-4 fw-bold">@Model.LatestHighRiskDeviceCount</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-light rounded-3">
                        <div class="text-muted small">Medios</div>
                        <div class="fs-4 fw-bold">@Model.LatestMediumRiskDeviceCount</div>
                    </div>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="mt-3 text-muted">@Model.Notes</div>
            }
        }
    </div>
</div>

<div class="card telemetry-card telemetry-card-static mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
                <h5 class="mb-1">Equipos observados en red</h5>
                <div class="text-muted small">Vista principal de recopilacion en vivo.</div>
            </div>
        </div>
        <div class="telemetry-filter-panel p-3 mb-3">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-xl-4">
                    <label class="form-label small text-muted">Buscar</label>
