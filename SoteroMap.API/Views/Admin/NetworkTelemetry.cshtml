        const scheduledWeekdaySelect = document.getElementById("telemetry-scheduled-weekday");
        const scheduledTimeSlotSelect = document.getElementById("telemetry-scheduled-time-slot");
        const scheduledSortSelect = document.getElementById("telemetry-scheduled-sort");
        const scheduledDirectionSelect = document.getElementById("telemetry-scheduled-direction");
        const scheduledPageSizeSelect = document.getElementById("telemetry-scheduled-page-size");
        const initialScheduledScanPage = @Html.Raw(ViewData["InitialScheduledScanPageJson"] as string ?? "{}");
        const initialScheduledScanRuns = Array.isArray(initialScheduledScanPage?.items)
            ? initialScheduledScanPage.items
            : @Html.Raw(ViewData["InitialScheduledScanRunsJson"] as string ?? "[]");
        const subnetRiskSummaries = @Html.Raw(JsonSerializer.Serialize(Model.SubnetRiskSummaries, telemetryJsonOptions));
        let latestDevicePage = null;
        let pendingSnapshotId = 0;
        let lastKnownSnapshotId = activeSnapshotId;
        let sessionSortDirection = "desc";
        let subnetSortBy = "risk";
        let subnetSortDirection = "desc";
        let scheduledLastSignature = "";

        const openScanModal = () => {
            if (!scanModalElement) {
                return false;
            }

            scanModalElement.classList.add("is-open");
            scanModalElement.setAttribute("aria-hidden", "false");
            document.body.classList.add("session-warning-open");
            return true;
        };

        const closeScanModal = () => {
            if (!scanModalElement) {
                return;
            }

            scanModalElement.classList.remove("is-open");
            scanModalElement.setAttribute("aria-hidden", "true");
            document.body.classList.remove("session-warning-open");
        };

        if (!deviceTable || !deviceSummary || !devicePagination) {
            return;
        }

        filterButton?.addEventListener("click", () => loadDevices(1));
        clearButton?.addEventListener("click", () => {
            if (searchInput) searchInput.value = "";
            if (riskSelect) riskSelect.value = "";
            if (subnetInput) subnetInput.value = "";
            if (onlineSelect) onlineSelect.value = "";
            if (sortBySelect) sortBySelect.value = "risk";
            if (sortDirectionSelect) sortDirectionSelect.value = "desc";
            if (pageSizeSelect) pageSizeSelect.value = "10";
            loadDevices(1);
        });
        scanButton?.addEventListener("click", () => {
            if (scanFeedback) {
                scanFeedback.textContent = "";
                scanFeedback.className = "small text-muted mt-3";
            }

            if (openScanModal()) {
                return;
            }

            alert("No fue posible abrir la ventana de escaneo. Recarga la pagina e intentalo de nuevo.");
        });

        scanCloseButton?.addEventListener("click", closeScanModal);
        scanCancelButton?.addEventListener("click", closeScanModal);
        scanModalElement?.addEventListener("click", (event) => {
            if (event.target === scanModalElement) {
                closeScanModal();
            }
        });
        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && scanModalElement?.classList.contains("is-open")) {
                closeScanModal();
            }
        });

        scanConfirmButton?.addEventListener("click", async () => {
            const originalConfirmHtml = scanConfirmButton.innerHTML;
            const originalScanHtml = scanButton ? scanButton.innerHTML : "";
            const controller = new AbortController();
            const timeoutId = window.setTimeout(() => controller.abort(), 12000);
            scanConfirmButton.disabled = true;
            if (scanButton) {
                scanButton.disabled = true;
                scanButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Solicitando...';
            }
            scanConfirmButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Solicitando...';
            if (scanFeedback) {
                scanFeedback.textContent = "Enviando solicitud al agente Windows...";
                scanFeedback.className = "small text-muted mt-3";
            }
            try {
                const response = await fetch("/api/network-telemetry/scan", {
                    method: "POST",
                    credentials: "include",
                    signal: controller.signal,
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        resolveInteractiveSessions: !!resolveSessionsCheckbox?.checked,
                        scanMode: scanModeSelect?.value || "simple"
                    })
                });

                if (!response.ok) {
                    throw new Error(`La API respondio ${response.status}`);
                }

                const raw = await response.text();
                const result = raw ? JSON.parse(raw) : {};
                if (scanFeedback) {
                    scanFeedback.textContent = result?.message || "Solicitud enviada al agente Windows.";
                    scanFeedback.className = "small text-success mt-3";
                }
                if (agentState) {
                    agentState.textContent = result?.message || "Solicitud enviada al agente Windows.";
                }
                window.clearTimeout(timeoutId);
                scanConfirmButton.disabled = false;
                scanConfirmButton.innerHTML = originalConfirmHtml;
                if (scanButton) {
                    scanButton.innerHTML = originalScanHtml;
                }
                closeScanModal();
                window.setTimeout(() => loadAgentStatus(true), 1200);
            } catch (error) {
                console.error("Error ejecutando escaneo de telemetria:", error);
                window.clearTimeout(timeoutId);
                if (scanButton) {
                    scanButton.disabled = false;
                    scanButton.innerHTML = originalScanHtml;
                }
                scanConfirmButton.disabled = false;
                scanConfirmButton.innerHTML = originalConfirmHtml;
                if (scanFeedback) {
                    scanFeedback.textContent = error?.name === "AbortError"
                        ? "La solicitud tardo demasiado en responder. Revisa el estado del agente y vuelve a intentar."
                        : "No fue posible ejecutar el escaneo de red.";
                    scanFeedback.className = "small text-danger mt-3";
                }
            }
        });

        const sendAgentControl = async (action) => {
            try {
                const response = await fetch("/api/network-telemetry/agent/control", {
                    method: "POST",
                    credentials: "include",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ action })
                });

                if (!response.ok) {
                    throw new Error(`La API respondio ${response.status}`);
                }

                const status = await response.json();
                renderAgentStatus(status, false);
            } catch (error) {
                console.error(`Error enviando control ${action} al agente:`, error);
            }
        };

        pauseButton?.addEventListener("click", () => sendAgentControl("pause"));
        resumeButton?.addEventListener("click", () => sendAgentControl("resume"));
        stopButton?.addEventListener("click", () => sendAgentControl("stop"));

        searchInput?.addEventListener("keydown", (event) => {
            if (event.key === "Enter") {
                event.preventDefault();
                loadDevices(1);
            }
        });
        pageSizeSelect?.addEventListener("change", () => loadDevices(1));
        sortBySelect?.addEventListener("change", () => loadDevices(1));
        sortDirectionSelect?.addEventListener("change", () => loadDevices(1));
        riskSelect?.addEventListener("change", () => loadDevices(1));
        onlineSelect?.addEventListener("change", () => loadDevices(1));

        const renderFilterChips = () => {
            if (!activeFiltersContainer) {
                return;
            }

            const chips = [];
            if (searchInput?.value?.trim()) {
                chips.push(`Busqueda: ${searchInput.value.trim()}`);
            }
            if (riskSelect?.value) {
                chips.push(`Riesgo: ${riskSelect.value}`);
            }
            if (onlineSelect?.value) {
                chips.push(`Red: ${onlineSelect.value}`);
            }
            if (subnetInput?.value?.trim()) {
                chips.push(`Subred: ${subnetInput.value.trim()}`);
            }
            if (sortBySelect?.value) {
                chips.push(`Orden: ${sortBySelect.value} ${sortDirectionSelect?.value || "desc"}`);
            }
            if (pageSizeSelect?.value) {
                chips.push(`Pagina: ${pageSizeSelect.value}`);
            }

            activeFiltersContainer.innerHTML = chips.length === 0
                ? `<span class="small text-muted">Sin filtros activos.</span>`
                : chips.map((chip) => `<span class="telemetry-chip">${chip}</span>`).join("");
        };

        const getSortIcon = (active, direction) => {
            if (!active) {
                return "bi-dash-lg";
            }

            return direction === "asc" ? "bi-chevron-up" : "bi-chevron-down";
        };

        const chileTimeZone = "America/Santiago";

        const parseApiUtcDate = (value) => {
            if (!value) {
                return null;
            }

            if (value instanceof Date) {
                return Number.isNaN(value.getTime()) ? null : value;
            }

            const text = String(value).trim();
            if (!text) {
                return null;
            }

            const normalized = /z|[+\-]\d{2}:\d{2}$/i.test(text) ? text : `${text}Z`;
            const parsed = new Date(normalized);
            return Number.isNaN(parsed.getTime()) ? null : parsed;
        };

        const formatChileDateTime = (value) => {
            const parsed = parseApiUtcDate(value);
            if (!parsed) {
                return "";
            }

            return new Intl.DateTimeFormat("es-CL", {
                timeZone: chileTimeZone,
                year: "numeric",
                month: "2-digit",
                day: "2-digit",
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit",
                hour12: false
            }).format(parsed);
        };

        const formatChileWeekday = (value) => {
            const parsed = parseApiUtcDate(value);
            if (!parsed) {
                return "";
            }

            return new Intl.DateTimeFormat("es-CL", {
                timeZone: chileTimeZone,
                weekday: "long"
            }).format(parsed);
        };

        const formatChileTime = (value) => {
            const parsed = parseApiUtcDate(value);
            if (!parsed) {
                return "";
            }

            return new Intl.DateTimeFormat("es-CL", {
                timeZone: chileTimeZone,
                hour: "2-digit",
                minute: "2-digit",
                hour12: false
            }).format(parsed);
        };

        const formatChileDate = (value) => {
            const parsed = parseApiUtcDate(value);
            if (!parsed) {
                return "";
            }

            return new Intl.DateTimeFormat("es-CL", {
                timeZone: chileTimeZone,
                year: "numeric",
                month: "2-digit",
                day: "2-digit"
            }).format(parsed);
        };

        const buildSortableHeader = (label, key, currentSortBy, currentDirection, datasetName) => {
            const active = currentSortBy === key;
            return `<button type="button" class="telemetry-sort-button ${active ? "is-active" : ""}" data-${datasetName}-sort="${key}">
                <span>${label}</span>
                <i class="bi ${getSortIcon(active, currentDirection)}"></i>
            </button>`;
        };

        const renderDeviceLoading = (message = "Consultando equipos observados...") => {
            if (!deviceTable) {
                return;
            }

            deviceTable.innerHTML = `
                <div class="telemetry-loading-shell">
                    <div class="telemetry-loading-content">
                        <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                        <div class="fw-semibold">${message}</div>
                        <div class="small text-muted">Estamos recopilando y ordenando los equipos observados de la ultima captura.</div>
                    </div>
                </div>`;
        };

        const renderSessionLoading = (message = "Consultando endpoints...") => {
            if (!sessionTable) {
                return;
            }

            sessionTable.innerHTML = `
                <div class="telemetry-loading-shell">
                    <div class="telemetry-loading-content">
                        <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                        <div class="fw-semibold">${message}</div>
                        <div class="small text-muted">Estamos organizando identidades, estados de sesion y conectividad detectada.</div>
                    </div>
                </div>`;
        };

        const renderSnapshotLoading = (message = "Consultando snapshots...") => {
            if (!snapshotTable) {
                return;
            }

            snapshotTable.innerHTML = `
                <div class="telemetry-loading-shell">
                    <div class="telemetry-loading-content">
                        <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                        <div class="fw-semibold">${message}</div>
                        <div class="small text-muted">Estamos reuniendo el historial de capturas manuales, automaticas y programadas.</div>
                    </div>
                </div>`;
        };

        const toggleSort = (currentSortBy, currentDirection, nextSortBy) => {
            if (currentSortBy === nextSortBy) {
                return currentDirection === "asc" ? "desc" : "asc";
            }

            return "asc";
        };

        if (!activeSnapshotId) {
            deviceTable.textContent = "Aun no hay equipos observados para mostrar.";
            return;
        }

        const renderDevices = (data) => {
            const items = Array.isArray(data?.items) ? data.items : [];
            const totalCount = Number(data?.totalCount) || 0;
            const page = Number(data?.page) || 1;
            const totalPages = Number(data?.totalPages) || 1;
            latestDevicePage = data;
            renderFilterChips();

            deviceSummary.textContent = `Mostrando ${items.length} de ${totalCount} equipos observados. Pagina ${page} de ${totalPages}.`;

            if (items.length === 0) {
                deviceTable.innerHTML = `<div class="text-muted">No se encontraron equipos con ese filtro.</div>`;
            } else {
                const currentSortBy = data?.sortBy || sortBySelect?.value || "risk";
                const currentDirection = data?.sortDirection || sortDirectionSelect?.value || "desc";
                const rows = items.map((item) => `
                    <tr class="${Number(item.id) === activeSnapshotId ? "telemetry-row-active" : ""}">
                        <td class="fw-semibold">${item.serialNumber || ""}</td>
                        <td>
                            <div class="fw-semibold">${item.deviceName || item.hostName || "Sin nombre"}</div>
                            <div class="small text-muted">${item.hostName || ""}${item.processor ? ` | ${item.processor}` : ""}</div>
                        </td>
                        <td>${item.username || ""}</td>
                        <td>${item.subnetCidr || ""}</td>
                        <td>${item.networkProfile || ""}</td>
                        <td>${item.ipAddress || ""}</td>
                        <td>${item.macAddress || ""}</td>
                        <td>${item.operatingSystem || ""} ${item.operatingSystemVersion || ""}</td>
                        <td>${item.manufacturer || ""} ${item.model || ""}</td>
                        <td>${item.antivirusStatus || ""}</td>
                        <td>${item.patchStatus || ""}</td>
                        <td>${item.isOnline === true ? '<span class="badge bg-success-subtle text-success-emphasis">Online</span>' : item.isOnline === false ? '<span class="badge bg-secondary-subtle text-secondary-emphasis">Offline</span>' : '<span class="badge bg-light text-muted">Sin dato</span>'}</td>
                        <td>${item.pingMs ?? ""}${item.pingMs != null ? " ms" : ""}</td>
                        <td><span class="telemetry-pill telemetry-pill-${item.riskLevel || "unknown"}">${item.riskLevel || ""} (${item.riskScore ?? 0})</span></td>
                    </tr>
                `).join("");

                deviceTable.innerHTML = `
                    <div class="telemetry-table-wrap table-responsive">
                        <table class="table align-middle table-sm">
                            <thead>
                                <tr>
                                    <th>${buildSortableHeader("S/N", "serial", currentSortBy, currentDirection, "device")}</th>
                                    <th>${buildSortableHeader("Equipo", "device", currentSortBy, currentDirection, "device")}</th>
                                    <th>${buildSortableHeader("Usuario", "user", currentSortBy, currentDirection, "device")}</th>
                                    <th>${buildSortableHeader("Subred", "subnet", currentSortBy, currentDirection, "device")}</th>
                                    <th>${buildSortableHeader("Perfil", "profile", currentSortBy, currentDirection, "device")}</th>
                                    <th>${buildSortableHeader("IP", "ip", currentSortBy, currentDirection, "device")}</th>
                                    <th>${buildSortableHeader("MAC", "mac", currentSortBy, currentDirection, "device")}</th>
                                    <th>${buildSortableHeader("SO", "os", currentSortBy, currentDirection, "device")}</th>
                                    <th>${buildSortableHeader("Modelo", "model", currentSortBy, currentDirection, "device")}</th>
                                    <th>${buildSortableHeader("AV", "antivirus", currentSortBy, currentDirection, "device")}</th>
                                    <th>${buildSortableHeader("Parches", "patch", currentSortBy, currentDirection, "device")}</th>
                                    <th>${buildSortableHeader("Red", "online", currentSortBy, currentDirection, "device")}</th>
                                    <th>${buildSortableHeader("Ping", "ping", currentSortBy, currentDirection, "device")}</th>
                                    <th>${buildSortableHeader("Riesgo", "risk", currentSortBy, currentDirection, "device")}</th>
                                </tr>
                            </thead>
                            <tbody>${rows}</tbody>
                        </table>
                    </div>
                `;

                deviceTable.querySelectorAll("[data-device-sort]").forEach((button) => {
                    button.addEventListener("click", () => {
                        const nextSortBy = button.getAttribute("data-device-sort") || "risk";
                        const nextDirection = toggleSort(sortBySelect?.value || "risk", sortDirectionSelect?.value || "desc", nextSortBy);
                        if (sortBySelect) sortBySelect.value = nextSortBy;
                        if (sortDirectionSelect) sortDirectionSelect.value = nextDirection;
                        loadDevices(1);
                    });
                });
            }

            const previousDisabled = page <= 1 ? "disabled" : "";
            const nextDisabled = page >= totalPages ? "disabled" : "";
            devicePagination.innerHTML = `
                <button type="button" class="btn btn-outline-secondary btn-sm" ${previousDisabled} data-page="${page - 1}">Anterior</button>
                <span class="align-self-center small text-muted">Pagina ${page} de ${totalPages}</span>
                <button type="button" class="btn btn-outline-secondary btn-sm" ${nextDisabled} data-page="${page + 1}">Siguiente</button>
            `;

            devicePagination.querySelectorAll("[data-page]").forEach((button) => {
                button.addEventListener("click", () => {
                    const nextPage = Number(button.getAttribute("data-page"));
                    if (Number.isFinite(nextPage) && nextPage >= 1) {
                        loadDevices(nextPage);
                    }
                });
            });
        };

        const loadDevices = (page = 1) => {
            renderDeviceLoading();

            if (page === 1
                && !deviceTable.dataset.initialized
                && initialDevicePage
                && Array.isArray(initialDevicePage.items)
                && initialDevicePage.items.length > 0
                && Number(initialDevicePage.snapshotId || 0) === activeSnapshotId) {
                deviceTable.dataset.initialized = "true";
                renderDevices(initialDevicePage);
                return;
            }

            const params = new URLSearchParams({
                page: String(page),
                pageSize: pageSizeSelect?.value || "10",
                sortBy: sortBySelect?.value || "risk",
                sortDirection: sortDirectionSelect?.value || "desc"
            });

            if (searchInput?.value?.trim()) {
                params.set("search", searchInput.value.trim());
            }
            if (riskSelect?.value) {
                params.set("riskLevel", riskSelect.value);
            }
            if (subnetInput?.value?.trim()) {
                params.set("subnetCidr", subnetInput.value.trim());
            }
            if (onlineSelect?.value) {
                params.set("onlineState", onlineSelect.value);
            }

            fetch(`/api/network-telemetry/snapshots/${activeSnapshotId}/devices?${params.toString()}`, {
                credentials: "include",
                cache: "no-store"
            })
                .then((response) => {
                    if (!response.ok) {
                        throw new Error(`La API respondio ${response.status}`);
                    }
                    return response.json();
                })
                .then(renderDevices)
                .catch((error) => {
                    console.error("Error cargando equipos de telemetria:", error);
                    if (!latestDevicePage && initialDevicePage && Array.isArray(initialDevicePage.items) && initialDevicePage.items.length > 0) {
                        renderDevices(initialDevicePage);
                        deviceSummary.textContent += " | Mostrando respaldo precargado.";
                        return;
                    }

                    deviceTable.textContent = "No fue posible cargar el detalle de equipos.";
                });
        };

        exportButton?.addEventListener("click", () => {
            const modal = new bootstrap.Modal(document.getElementById("exportLoadingModal"));
            modal.show();
            fetch(`/api/network-telemetry/office/snapshots/${activeSnapshotId}/devices/export`)
                .then((res) => {
                    if (!res.ok) throw new Error();
                    const disposition = res.headers.get("Content-Disposition") || "";
                    const match = disposition.match(/filename\*?=(?:UTF-8'')?([^;\s]+)/i);
                    const filename = match ? decodeURIComponent(match[1]) : `telemetria_red_snapshot_${activeSnapshotId}.xlsx`;
                    return res.blob().then((blob) => ({ blob, filename }));
                })
                .then(({ blob, filename }) => {
                    modal.hide();
                    const url = URL.createObjectURL(blob);
                    const link = document.createElement("a");
                    link.href = url;
                    link.download = filename;
                    link.click();
                    URL.revokeObjectURL(url);
                })
                .catch(() => modal.hide());
        });

        const renderClientPager = (container, page, totalPages, callback) => {
            if (!container) {
                return;
            }

            container.innerHTML = `
                <button type="button" class="btn btn-outline-secondary btn-sm" ${page <= 1 ? "disabled" : ""} data-page="${page - 1}">Anterior</button>
                <span class="align-self-center small text-muted">Pagina ${page} de ${totalPages}</span>
                <button type="button" class="btn btn-outline-secondary btn-sm" ${page >= totalPages ? "disabled" : ""} data-page="${page + 1}">Siguiente</button>
            `;

            container.querySelectorAll("[data-page]").forEach((button) => {
                button.addEventListener("click", () => callback(Number(button.getAttribute("data-page")) || 1));
            });
        };

        const renderSubnetRiskSummaries = (page = 1) => {
            if (!subnetTable || !subnetSummary || !subnetPagination) {
                return;
            }

            let items = Array.isArray(subnetRiskSummaries) ? [...subnetRiskSummaries] : [];
            const pageSize = Number(subnetPageSizeSelect?.value || "10");
            items.sort((left, right) => {
                const leftValue = subnetSortBy === "subnet"
                    ? String(left.subnetCidr || "")
                    : subnetSortBy === "devices"
                        ? Number(left.deviceCount || 0)
                        : subnetSortBy === "critical"
                            ? Number(left.criticalCount || 0)
                            : subnetSortBy === "high"
                                ? Number(left.highCount || 0)
                                : subnetSortBy === "medium"
                                    ? Number(left.mediumCount || 0)
                                    : subnetSortBy === "low"
                                        ? Number(left.lowCount || 0)
                                        : Number(left.maxRiskScore || 0);
                const rightValue = subnetSortBy === "subnet"
                    ? String(right.subnetCidr || "")
                    : subnetSortBy === "devices"
                        ? Number(right.deviceCount || 0)
                        : subnetSortBy === "critical"
                            ? Number(right.criticalCount || 0)
                            : subnetSortBy === "high"
                                ? Number(right.highCount || 0)
                                : subnetSortBy === "medium"
                                    ? Number(right.mediumCount || 0)
                                    : subnetSortBy === "low"
                                        ? Number(right.lowCount || 0)
                                        : Number(right.maxRiskScore || 0);

                if (typeof leftValue === "string" || typeof rightValue === "string") {
                    const result = String(leftValue).localeCompare(String(rightValue), "es");
                    return subnetSortDirection === "asc" ? result : -result;
                }

                const result = Number(leftValue) - Number(rightValue);
                return subnetSortDirection === "asc" ? result : -result;
            });
            const totalCount = items.length;
            const totalPages = Math.max(1, Math.ceil(totalCount / pageSize));
            const safePage = Math.min(Math.max(1, page), totalPages);
            const pageItems = items.slice((safePage - 1) * pageSize, safePage * pageSize);

            subnetSummary.textContent = totalCount === 0
                ? "No hay subredes con equipos observados en el ultimo snapshot."
                : `Mostrando ${pageItems.length} de ${totalCount} subredes. Pagina ${safePage} de ${totalPages}.`;

            if (pageItems.length === 0) {
                subnetTable.innerHTML = `<div class="text-muted">No hay subredes con equipos observados en el ultimo snapshot.</div>`;
            } else {
                subnetTable.innerHTML = `
                    <div class="telemetry-table-wrap table-responsive">
                        <table class="table align-middle table-sm">
                            <thead>
                                <tr>
                                    <th>${buildSortableHeader("Subred", "subnet", subnetSortBy, subnetSortDirection, "subnet")}</th>
                                    <th>${buildSortableHeader("Eq.", "devices", subnetSortBy, subnetSortDirection, "subnet")}</th>
                                    <th>${buildSortableHeader("C", "critical", subnetSortBy, subnetSortDirection, "subnet")}</th>
                                    <th>${buildSortableHeader("A", "high", subnetSortBy, subnetSortDirection, "subnet")}</th>
                                    <th>${buildSortableHeader("M", "medium", subnetSortBy, subnetSortDirection, "subnet")}</th>
                                    <th>${buildSortableHeader("B", "low", subnetSortBy, subnetSortDirection, "subnet")}</th>
                                    <th>${buildSortableHeader("Max.", "risk", subnetSortBy, subnetSortDirection, "subnet")}</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                ${pageItems.map((item) => `
                                    <tr class="telemetry-clickable-row" data-subnet-filter="${item.subnetCidr || ""}">
                                        <td>${item.subnetCidr || ""}</td>
                                        <td>${item.deviceCount ?? 0}</td>
                                        <td>${item.criticalCount ?? 0}</td>
                                        <td>${item.highCount ?? 0}</td>
                                        <td>${item.mediumCount ?? 0}</td>
                                        <td>${item.lowCount ?? 0}</td>
                                        <td><span class="telemetry-pill telemetry-pill-${item.maxRiskLevel || "unknown"}">${item.maxRiskLevel || ""} (${item.maxRiskScore ?? 0})</span></td>
                                        <td><button type="button" class="btn btn-sm btn-outline-primary" data-subnet-filter="${item.subnetCidr || ""}">Ver</button></td>
                                    </tr>
                                `).join("")}
                            </tbody>
                        </table>
                    </div>`;
            }

            subnetTable.querySelectorAll("[data-subnet-filter]").forEach((button) => {
                button.addEventListener("click", () => {
                    if (subnetInput) {
                        subnetInput.value = button.getAttribute("data-subnet-filter") || "";
                        loadDevices(1);
                    }
                });
            });

            subnetTable.querySelectorAll("[data-subnet-sort]").forEach((button) => {
                button.addEventListener("click", () => {
                    const nextSortBy = button.getAttribute("data-subnet-sort") || "risk";
                    subnetSortDirection = toggleSort(subnetSortBy, subnetSortDirection, nextSortBy);
                    subnetSortBy = nextSortBy;
                    renderSubnetRiskSummaries(1);
                });
            });

            renderClientPager(subnetPagination, safePage, totalPages, renderSubnetRiskSummaries);
        };

        const sessionStateBadge = (state, label) => {
            if (state === "active") return `<span class="badge bg-success">${label}</span>`;
            if (state === "locked") return `<span class="badge bg-danger">${label}</span>`;
            if (state === "mfa-pending") return `<span class="badge bg-warning text-dark">${label}</span>`;
            return `<span class="badge bg-secondary">${label}</span>`;
        };

        const buildSessionRows = (items) => items.map((user) => `
            <tr>
                <td class="fw-semibold">${user.username || ""}</td>
                <td>${user.role || ""}</td>
                <td>${sessionStateBadge(user.sessionState, user.sessionStateLabel || user.sessionState || "")}</td>
                <td>${user.subnetCidr || ""}</td>
                <td>${user.lastSeenAtUtc ? formatChileDateTime(user.lastSeenAtUtc) : "-"}</td>
                <td>${user.pingMs == null ? "-" : `${user.pingMs} ms`}</td>
                <td>${user.openPorts || ""}</td>
                <td><span class="telemetry-pill telemetry-pill-${user.riskLevel || "unknown"}">${user.riskLevel || ""} (${user.riskScore ?? 0})</span></td>
                <td>${user.linkedDeviceCount ?? 0}</td>
            </tr>
        `).join("");

        const renderSessions = (page = 1) => {
            if (!sessionTable || !sessionSummary || !sessionPagination) {
                return;
            }

            renderSessionLoading();

            const search = sessionSearchInput?.value?.trim().toLowerCase() || "";
            const state = sessionStateSelect?.value || "";
            const sortBy = sessionSortSelect?.value || "risk";
            const pageSize = Number(sessionPageSizeSelect?.value || "10");

            let items = Array.isArray(sessionUsers) ? [...sessionUsers] : [];
            if (search) {
                items = items.filter((item) =>
                    [item.username, item.role, item.subnetCidr, item.networkProfile, item.openPorts]
                        .filter(Boolean)
                        .join(" ")
                        .toLowerCase()
                        .includes(search));
            }
            if (state) {
                items = items.filter((item) => item.sessionState === state);
            }

            items.sort((left, right) => {
                const result = sortBy === "username"
                    ? String(left.username || "").localeCompare(String(right.username || ""), "es")
                    : sortBy === "role"
                        ? String(left.role || "").localeCompare(String(right.role || ""), "es")
                        : sortBy === "state"
                            ? String(left.sessionStateLabel || left.sessionState || "").localeCompare(String(right.sessionStateLabel || right.sessionState || ""), "es")
                            : sortBy === "subnet"
                                ? String(left.subnetCidr || "").localeCompare(String(right.subnetCidr || ""), "es")
                                : sortBy === "lastSeen"
                                    ? new Date(left.lastSeenAtUtc || 0) - new Date(right.lastSeenAtUtc || 0)
                                    : sortBy === "ping"
                                        ? Number(left.pingMs || 0) - Number(right.pingMs || 0)
                                        : sortBy === "ports"
                                            ? String(left.openPorts || "").localeCompare(String(right.openPorts || ""), "es")
                                            : sortBy === "linkedDevices"
                                                ? Number(left.linkedDeviceCount || 0) - Number(right.linkedDeviceCount || 0)
                                                : Number(left.riskScore || 0) - Number(right.riskScore || 0);
                return sessionSortDirection === "asc" ? result : -result;
            });

            const totalCount = items.length;
            const totalPages = Math.max(1, Math.ceil(totalCount / pageSize));
            const safePage = Math.min(Math.max(1, page), totalPages);
            const pageItems = items.slice((safePage - 1) * pageSize, safePage * pageSize);

            sessionSummary.textContent = `Mostrando ${pageItems.length} de ${totalCount} endpoints.`;
            sessionTable.innerHTML = totalCount === 0
                ? `<div class="text-muted">No hay endpoints para ese filtro.</div>`
                : `<div class="telemetry-table-wrap table-responsive"><table class="table align-middle"><thead><tr><th>${buildSortableHeader("Endpoint", "username", sortBy, sessionSortDirection, "session")}</th><th>${buildSortableHeader("Perfil", "role", sortBy, sessionSortDirection, "session")}</th><th>${buildSortableHeader("Estado", "state", sortBy, sessionSortDirection, "session")}</th><th>${buildSortableHeader("Subred", "subnet", sortBy, sessionSortDirection, "session")}</th><th>${buildSortableHeader("Ultima deteccion", "lastSeen", sortBy, sessionSortDirection, "session")}</th><th>${buildSortableHeader("Latencia", "ping", sortBy, sessionSortDirection, "session")}</th><th>${buildSortableHeader("Puertos", "ports", sortBy, sessionSortDirection, "session")}</th><th>${buildSortableHeader("Riesgo", "risk", sortBy, sessionSortDirection, "session")}</th><th>${buildSortableHeader("Equipos", "linkedDevices", sortBy, sessionSortDirection, "session")}</th></tr></thead><tbody>${buildSessionRows(pageItems)}</tbody></table></div>`;

            sessionTable.querySelectorAll("[data-session-sort]").forEach((button) => {
                button.addEventListener("click", () => {
                    const nextSortBy = button.getAttribute("data-session-sort") || "risk";
                    sessionSortDirection = toggleSort(sessionSortSelect?.value || "risk", sessionSortDirection, nextSortBy);
                    if (sessionSortSelect) {
                        sessionSortSelect.value = nextSortBy;
                    }
                    renderSessions(1);
                });
            });

            renderClientPager(sessionPagination, safePage, totalPages, renderSessions);
        };

        const renderSnapshots = (data) => {
            if (!snapshotTable || !snapshotSummary || !snapshotPagination) {
                return;
            }

            const items = Array.isArray(data?.items) ? data.items : [];
            const totalCount = Number(data?.totalCount) || 0;
            const page = Number(data?.page) || 1;
            const totalPages = Number(data?.totalPages) || 1;

            snapshotSummary.textContent = `Mostrando ${items.length} de ${totalCount} snapshots. Pagina ${page} de ${totalPages}.`;
            snapshotTable.innerHTML = items.length === 0
                ? `<div class="text-muted">No hay snapshots para ese filtro.</div>`
                : `<div class="telemetry-table-wrap table-responsive"><table class="table align-middle"><thead><tr><th>Fecha</th><th>Fuente</th><th>Estado</th><th>Usuarios</th><th>Equipos</th><th>Riesgo</th></tr></thead><tbody>${items.map((item) => `
                    <tr>
                        <td>${item.observedAtUtc ? formatChileDateTime(item.observedAtUtc) : ""}</td>
                        <td><div class="fw-semibold">${item.sourceName || ""}</div><div class="small text-muted">${item.sourceType || ""} · ${item.triggerLabel || ""}</div></td>
                        <td><div>${item.status || ""}</div><div class="small text-muted">${item.createdByUsername || ""}</div></td>
                        <td>${item.connectedUserCount ?? 0}</td>
                        <td>${item.deviceCount ?? 0}</td>
                        <td><span class="telemetry-pill telemetry-pill-${item.riskLevel || "unknown"}">${item.riskLevel || ""} (${item.riskScore ?? 0})</span></td>
                    </tr>`).join("")}</tbody></table></div>`;

            renderClientPager(snapshotPagination, page, totalPages, loadSnapshots);
        };

        const renderSnapshotsEnhanced = (data) => {
            if (!snapshotTable || !snapshotSummary || !snapshotPagination) {
                return;
            }

            const items = Array.isArray(data?.items) ? data.items : [];
            const totalCount = Number(data?.totalCount) || 0;
            const page = Number(data?.page) || 1;
            const totalPages = Number(data?.totalPages) || 1;
            const currentSortBy = data?.sortBy || snapshotSortSelect?.value || "observedAt";
            const currentDirection = data?.sortDirection || snapshotDirectionSelect?.value || "desc";

            snapshotSummary.textContent = `Mostrando ${items.length} de ${totalCount} snapshots. Pagina ${page} de ${totalPages}.`;
            snapshotTable.innerHTML = items.length === 0
                ? `<div class="text-muted">No hay snapshots para ese filtro.</div>`
                : `<div class="telemetry-table-wrap table-responsive"><table class="table align-middle"><thead><tr><th>${buildSortableHeader("Fecha", "observedAt", currentSortBy, currentDirection, "snapshot")}</th><th>${buildSortableHeader("Dia", "weekday", currentSortBy, currentDirection, "snapshot")}</th><th>${buildSortableHeader("Hora", "timeSlot", currentSortBy, currentDirection, "snapshot")}</th><th>${buildSortableHeader("Fuente", "sourceName", currentSortBy, currentDirection, "snapshot")}</th><th>${buildSortableHeader("Estado", "triggerType", currentSortBy, currentDirection, "snapshot")}</th><th>${buildSortableHeader("Usuarios", "connectedUserCount", currentSortBy, currentDirection, "snapshot")}</th><th>${buildSortableHeader("Equipos", "deviceCount", currentSortBy, currentDirection, "snapshot")}</th><th>${buildSortableHeader("Riesgo", "riskScore", currentSortBy, currentDirection, "snapshot")}</th><th></th></tr></thead><tbody>${items.map((item) => `
                    <tr>
                        <td>${formatChileDateTime(item.observedAtUtc)}</td>
                        <td>${formatChileWeekday(item.observedAtUtc)}</td>
                        <td>${formatChileTime(item.observedAtUtc)}</td>
                        <td><div class="fw-semibold">${item.sourceName || ""}</div><div class="small text-muted">${item.sourceType || ""} · ${item.triggerLabel || ""}</div></td>
                        <td><div>${item.status || ""}</div><div class="small text-muted">${item.createdByUsername || ""}</div></td>
                        <td>${item.connectedUserCount ?? 0}</td>
                        <td>${item.deviceCount ?? 0}</td>
                        <td><span class="telemetry-pill telemetry-pill-${item.riskLevel || "unknown"}">${item.riskLevel || ""} (${item.riskScore ?? 0})</span></td>
                        <td class="text-end text-nowrap">${Number(item.id) === activeSnapshotId ? '<span class="badge bg-primary-subtle text-primary-emphasis me-2">Activa</span>' : ''}<a href="/dashboard/network-telemetry?snapshotId=${item.id}" class="btn btn-sm btn-outline-primary me-1" title="Abrir esta snapshot"><i class="bi bi-eye"></i></a><button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar esta snapshot" data-delete-snapshot="${item.id}"><i class="bi bi-trash3"></i></button></td>
                    </tr>`).join("")}</tbody></table></div>`;

            snapshotTable.querySelectorAll("[data-snapshot-sort]").forEach((button) => {
                button.addEventListener("click", () => {
                    const nextSortBy = button.getAttribute("data-snapshot-sort") || "observedAt";
                    const nextDirection = toggleSort(snapshotSortSelect?.value || "observedAt", snapshotDirectionSelect?.value || "desc", nextSortBy);
                    if (snapshotSortSelect) snapshotSortSelect.value = nextSortBy;
                    if (snapshotDirectionSelect) snapshotDirectionSelect.value = nextDirection;
                    loadSnapshots(1);
                });
            });

            snapshotTable.querySelectorAll("[data-delete-snapshot]").forEach((button) => {
                button.addEventListener("click", () => {
                    const snapshotId = button.getAttribute("data-delete-snapshot");
                    if (!snapshotId || !confirm(`¿Esta seguro de eliminar la snapshot #${snapshotId}? Los datos de observacion asociados tambien se eliminaran.`)) {
                        return;
                    }

                    button.disabled = true;
                    button.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';

                    fetch(`/api/network-telemetry/snapshots/${snapshotId}`, {
                        method: "DELETE",
                        credentials: "include",
                        headers: { "Accept": "application/json" }
                    })
                        .then((response) => {
                            if (!response.ok) {
                                throw new Error(`La API respondio ${response.status}`);
                            }

                            return response.json();
                        })
                        .then(() => {
                            const currentPage = Number(new URLSearchParams(window.location.search).get("page")) || 1;
                            loadSnapshots(currentPage);
                        })
                        .catch((error) => {
                            console.error("Error eliminando snapshot:", error);
                            alert("No se pudo eliminar la snapshot.");
                            button.disabled = false;
                            button.innerHTML = '<i class="bi bi-trash3"></i>';
                        });
                });
            });

            renderClientPager(snapshotPagination, page, totalPages, loadSnapshots);
        };

        const loadSnapshots = (page = 1) => {
            if (!snapshotTable) {
                return;
            }

            renderSnapshotLoading();
            if (page === 1
                && !snapshotTable.dataset.initialized
                && initialSnapshotPage
                && Array.isArray(initialSnapshotPage.items)
                && initialSnapshotPage.items.length > 0) {
                snapshotTable.dataset.initialized = "true";
                renderSnapshotsEnhanced(initialSnapshotPage);
                return;
            }
            const params = new URLSearchParams({
                page: String(page),
                pageSize: snapshotPageSizeSelect?.value || "10",
                sortBy: snapshotSortSelect?.value || "observedAt",
                sortDirection: snapshotDirectionSelect?.value || "desc"
            });

            if (snapshotSearchInput?.value?.trim()) {
                params.set("search", snapshotSearchInput.value.trim());
            }
            if (snapshotTriggerSelect?.value) {
                params.set("triggerType", snapshotTriggerSelect.value);
            }
            if (snapshotWeekdaySelect?.value) {
                params.set("weekday", snapshotWeekdaySelect.value);
            }
            if (snapshotTimeSlotSelect?.value) {
                params.set("timeSlot", snapshotTimeSlotSelect.value);
            }

            fetch(`/api/network-telemetry/snapshots?${params.toString()}`, {
                credentials: "include",
                cache: "no-store"
            })
                .then((response) => {
                    if (!response.ok) {
                        throw new Error(`La API respondio ${response.status}`);
                    }
                    return response.json();
                })
                .then(renderSnapshotsEnhanced)
                .catch((error) => {
                    console.error("Error cargando snapshots de telemetria:", error);
                    if (initialSnapshotPage && Array.isArray(initialSnapshotPage.items) && initialSnapshotPage.items.length > 0) {
                        renderSnapshotsEnhanced(initialSnapshotPage);
                        snapshotSummary.textContent += " | Mostrando respaldo precargado.";
                        return;
                    }

                    snapshotTable.textContent = "No fue posible cargar el historial de snapshots.";
                });
        };

        const renderScheduledLoading = (message = "Consultando escaneos programados...") => {
            if (!scheduledTable) return;
            scheduledTable.innerHTML = `
                <div class="telemetry-loading-shell">
                    <div class="telemetry-loading-content">
                        <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                        <div class="fw-semibold">${message}</div>
                        <div class="small text-muted">Estamos reuniendo el historial de escaneos automaticos programados.</div>
                    </div>
                </div>`;
        };

        const renderScheduledScans = (data) => {
            if (!scheduledTable || !scheduledSummary || !scheduledPagination) return;

            const items = Array.isArray(data?.items) ? data.items : [];
            const totalCount = Number(data?.totalCount) || 0;
            const page = Number(data?.page) || 1;
            const totalPages = Number(data?.totalPages) || 1;
            const currentSortBy = data?.sortBy || scheduledSortSelect?.value || "scheduledAtUtc";
            const currentDirection = data?.sortDirection || scheduledDirectionSelect?.value || "desc";

            scheduledTable.dataset.currentPage = String(page);
            scheduledSummary.textContent = `Mostrando ${items.length} de ${totalCount} escaneos programados. Pagina ${page} de ${totalPages}.`;
            if (items.length === 0) {
                scheduledTable.innerHTML = `<div class="text-muted">No hay escaneos programados para ese filtro.</div>`;
                return;
            }
            scheduledTable.innerHTML = `<div class="telemetry-table-wrap table-responsive"><table class="table align-middle"><thead><tr>
                <th>ID</th>
                <th>${buildSortableHeader("Dia", "scheduledDayLocal", currentSortBy, currentDirection, "scheduled")}</th>
                <th>${buildSortableHeader("Hora", "scheduledTimeLocal", currentSortBy, currentDirection, "scheduled")}</th>
                <th>${buildSortableHeader("Fecha", "scheduledAtUtc", currentSortBy, currentDirection, "scheduled")}</th>
                <th>${buildSortableHeader("Inicio", "startedAtUtc", currentSortBy, currentDirection, "scheduled")}</th>
                <th>${buildSortableHeader("Estado", "status", currentSortBy, currentDirection, "scheduled")}</th>
                <th>Error</th>
                <th>${buildSortableHeader("Equipos", "deviceCount", currentSortBy, currentDirection, "scheduled")}</th>
                <th>${buildSortableHeader("Usuarios", "userCount", currentSortBy, currentDirection, "scheduled")}</th>
                <th>Accion</th>
            </tr></thead><tbody>${items.map((item) => {
                const statusBadge = item.status === "completed" ? '<span class="badge bg-success">Completado</span>'
                    : item.status === "failed" ? '<span class="badge bg-danger">Fallado</span>'
                    : item.status === "running" ? '<span class="badge bg-primary">Ejecutando</span>'
                    : item.status === "skipped" ? '<span class="badge bg-warning text-dark">Saltado</span>'
                    : item.status === "queued" ? '<span class="badge bg-info text-dark">En cola</span>'
                    : '<span class="badge bg-secondary">' + (item.statusLabel || item.status || "") + '</span>';
                const createdAt = item.createdAtUtc ? formatChileDate(item.createdAtUtc) : "-";
                const startedAt = item.startedAtUtc ? formatChileTime(item.startedAtUtc) : "-";
                const errMsg = item.status === "failed" && item.errorMessage ? `<div class="small text-danger" title="${item.errorMessage.replace(/"/g, "&quot;")}">${item.errorMessage.length > 80 ? item.errorMessage.substring(0, 80) + "..." : item.errorMessage}</div>` : "";
                const loadBtn = item.snapshotId > 0
                    ? `<a href="/dashboard/network-telemetry?snapshotId=${item.snapshotId}" class="btn btn-sm btn-outline-primary" title="Cargar esta snapshot"><i class="bi bi-eye"></i></a>`
                    : '<span class="text-muted">-</span>';
                return `<tr>
                    <td class="fw-semibold">#${item.id || "-"}</td>
                    <td>${item.scheduledDayLocal || ""}</td>
                    <td>${item.scheduledTimeLocal || ""}</td>
                    <td>${createdAt}</td>
                    <td>${startedAt}</td>
                    <td>${statusBadge}</td>
                    <td>${errMsg || '<span class="text-muted small">-</span>'}</td>
                    <td>${item.deviceCount != null ? item.deviceCount : '-'}</td>
                    <td>${item.userCount != null ? item.userCount : '-'}</td>
                    <td>${loadBtn}</td>
                </tr>`;
            }).join("")}</tbody></table></div>`;

            scheduledTable.querySelectorAll("[data-scheduled-sort]").forEach((button) => {
                button.addEventListener("click", () => {
                    const nextSortBy = button.getAttribute("data-scheduled-sort") || "scheduledAtUtc";
                    const nextDirection = toggleSort(scheduledSortSelect?.value || "scheduledAtUtc", scheduledDirectionSelect?.value || "desc", nextSortBy);
                    if (scheduledSortSelect) scheduledSortSelect.value = nextSortBy;
                    if (scheduledDirectionSelect) scheduledDirectionSelect.value = nextDirection;
                    loadScheduledScans(1);
                });
            });

            renderClientPager(scheduledPagination, page, totalPages, loadScheduledScans);
        };

        const loadScheduledScans = (page = 1, options = {}) => {
            if (!scheduledTable) return;

            const silent = Boolean(options?.silent);
            if (!silent) {
                renderScheduledLoading();
            }
            if (page === 1
                && !scheduledTable.dataset.initialized
                && initialScheduledScanRuns
                && Array.isArray(initialScheduledScanRuns)
                && initialScheduledScanRuns.length > 0) {
                scheduledTable.dataset.initialized = "true";
                const initialData = initialScheduledScanPage && typeof initialScheduledScanPage === "object" && !Array.isArray(initialScheduledScanPage)
                    ? initialScheduledScanPage
                    : { items: initialScheduledScanRuns, totalCount: initialScheduledScanRuns.length, page: 1, totalPages: Math.max(1, Math.ceil(initialScheduledScanRuns.length / 10)), sortBy: "scheduledAtUtc", sortDirection: "desc" };
                scheduledLastSignature = JSON.stringify(initialData);
                renderScheduledScans(initialData);
                return;
            }
            const params = new URLSearchParams({
                page: String(page),
                pageSize: scheduledPageSizeSelect?.value || "10",
                sortBy: scheduledSortSelect?.value || "scheduledAtUtc",
                sortDirection: scheduledDirectionSelect?.value || "desc"
            });

            if (scheduledSearchInput?.value?.trim()) {
                params.set("search", scheduledSearchInput.value.trim());
            }
            if (scheduledStatusSelect?.value) {
                params.set("status", scheduledStatusSelect.value);
            }
            if (scheduledWeekdaySelect?.value) {
                params.set("weekday", scheduledWeekdaySelect.value);
            }
            if (scheduledTimeSlotSelect?.value) {
                params.set("timeSlot", scheduledTimeSlotSelect.value);
            }

            fetch(`/api/network-telemetry/scheduled-scans?${params.toString()}`, {
                credentials: "include",
                cache: "no-store"
            })
                .then((response) => {
                    if (!response.ok) throw new Error(`API respondio ${response.status}`);
                    return response.json();
                })
                .then((data) => {
                    const signature = JSON.stringify({
                        items: Array.isArray(data?.items) ? data.items : [],
                        totalCount: Number(data?.totalCount) || 0,
                        page: Number(data?.page) || 1,
                        totalPages: Number(data?.totalPages) || 1,
                        sortBy: data?.sortBy || "",
                        sortDirection: data?.sortDirection || ""
                    });

                    if (silent && signature === scheduledLastSignature) {
                        return;
                    }

                    scheduledLastSignature = signature;
                    renderScheduledScans(data);
                })
                .catch((error) => {
                    console.error("Error cargando escaneos programados:", error);
                    if (Array.isArray(initialScheduledScanRuns) && initialScheduledScanRuns.length > 0) {
                        renderScheduledScans(initialScheduledScanPage && typeof initialScheduledScanPage === "object" && !Array.isArray(initialScheduledScanPage)
                            ? initialScheduledScanPage
                            : { items: initialScheduledScanRuns, totalCount: initialScheduledScanRuns.length, page: 1, totalPages: Math.max(1, Math.ceil(initialScheduledScanRuns.length / 10)), sortBy: "scheduledAtUtc", sortDirection: "desc" });
                    } else {
                        scheduledTable.textContent = "No fue posible cargar los escaneos programados.";
                    }
                });
        };

        const renderAgentStatus = (status, reloadWhenCompleted = false) => {
            if (!agentState) {
                return;
            }

            const state = status?.state || "idle";
            const message = status?.message || "Sin actividad reciente del agente Windows.";
            const triggerType = status?.triggerType || "";
            const triggerLabel = triggerType === "scheduled" ? "Programado"
                : triggerType === "automatic" ? "Automatico"
                : triggerType === "manual" ? "Manual"
                : "";
            const snapshotId = Number(status?.snapshotId) || 0;
            const updatedAt = formatChileDateTime(status?.updatedAtUtc);
            const heartbeatAt = formatChileDateTime(status?.lastHeartbeatAtUtc);
            const isConnected = !!status?.isConnected;
            const agentId = status?.agentId || "sin agente";
            const totalHosts = Number(status?.totalHosts) || 0;
            const processedHosts = Number(status?.processedHosts) || 0;
            const currentIpAddress = status?.currentIpAddress || "";
            const currentHostName = status?.currentHostName || "";
            const currentSubnetCidr = status?.currentSubnetCidr || "";
            const currentStage = status?.currentStage || "";
            const progressPercent = totalHosts > 0 ? Math.min(100, Math.max(0, Math.round((processedHosts / totalHosts) * 100))) : 0;
            const connectionTone = isConnected ? "success" : "secondary";
            const stateTone = state === "completed"
                ? "success"
                : state === "failed"
                    ? "danger"
                    : state === "paused" || state === "stopping"
                        ? "warning text-dark"
                        : "info";

            if (state === "completed" && snapshotId > lastKnownSnapshotId) {
                pendingSnapshotId = snapshotId;
                lastKnownSnapshotId = snapshotId;
            }

            const refreshButton = pendingSnapshotId > 0
                ? `<button type="button" class="btn btn-sm btn-light fw-semibold" id="telemetry-refresh-snapshot">
                        <i class="bi bi-arrow-repeat me-1"></i> Cargar ultimo snapshot
                   </button>`
                : "";

            agentState.innerHTML = `
                <div class="telemetry-agent-shell">
                    <div class="telemetry-agent-top">
                        <span class="badge bg-${connectionTone}">${isConnected ? "Conectado" : "Desconectado"}</span>
                        <span class="badge bg-${stateTone}">${state || "idle"}</span>
                        <span class="fw-semibold text-white">${agentId}</span>
                        ${refreshButton}
                    </div>
                    <div class="text-white">${message}${triggerLabel && state === "failed" ? ` <span class="badge bg-light text-dark">${triggerLabel}</span>` : ""}</div>
                    ${totalHosts > 0 ? `
                        <div class="telemetry-progress" aria-label="Progreso de escaneo">
                            <span style="width:${progressPercent}%"></span>
                        </div>
                        <div class="telemetry-agent-meta">
                            <span class="telemetry-agent-stat"><i class="bi bi-hdd-network"></i> ${processedHosts}/${totalHosts} hosts</span>
                            ${currentSubnetCidr ? `<span class="telemetry-agent-stat"><i class="bi bi-diagram-3"></i> ${currentSubnetCidr}</span>` : ""}
                            ${currentIpAddress ? `<span class="telemetry-agent-stat"><i class="bi bi-router"></i> ${currentIpAddress}</span>` : ""}
                            ${currentHostName ? `<span class="telemetry-agent-stat"><i class="bi bi-pc-display"></i> ${currentHostName}</span>` : ""}
                            ${currentStage ? `<span class="telemetry-agent-stat"><i class="bi bi-activity"></i> ${currentStage}</span>` : ""}
                        </div>` : ""}
                    <div class="telemetry-agent-meta">
                        ${triggerLabel ? `<span class="telemetry-agent-stat"><i class="bi bi-tag"></i> ${triggerLabel}</span>` : ""}
                        ${heartbeatAt ? `<span class="telemetry-agent-stat"><i class="bi bi-heart-pulse"></i> Latido ${heartbeatAt}</span>` : ""}
                        ${updatedAt ? `<span class="telemetry-agent-stat"><i class="bi bi-clock-history"></i> Estado ${updatedAt}</span>` : ""}
                        ${snapshotId > 0 ? `<span class="telemetry-agent-stat"><i class="bi bi-database-check"></i> Snapshot ${snapshotId}</span>` : ""}
                    </div>
                </div>`;

            document.getElementById("telemetry-refresh-snapshot")?.addEventListener("click", () => {
                const refreshButton = document.getElementById("telemetry-refresh-snapshot");
                if (refreshButton instanceof HTMLButtonElement) {
                    refreshButton.disabled = true;
                    refreshButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Cargando...';
                }

                const targetSnapshotId = pendingSnapshotId;
                pendingSnapshotId = 0;

                window.setTimeout(() => {
                    window.location.href = `/dashboard/network-telemetry?snapshotId=${targetSnapshotId}&t=${Date.now()}`;
                }, 120);
            });

            if (scanButton) {
                scanButton.disabled = !isConnected || state === "running" || state === "pending";
                if (!isConnected) {
                    scanButton.title = "El agente Windows no esta conectado.";
                    scanButton.innerHTML = '<i class="bi bi-radar me-1"></i> Escanear ahora';
                } else if (state === "running" || state === "pending") {
                    scanButton.title = "Ya existe un escaneo en curso.";
                    const scanLabel = triggerType === "scheduled" ? "Programado" : "Escaneo en curso";
                    scanButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>' + scanLabel;
                } else {
                    scanButton.title = "";
                    scanButton.innerHTML = '<i class="bi bi-radar me-1"></i> Escanear ahora';
                }
            }

            const runningBanner = document.getElementById("telemetry-scan-running-banner");
            const runningText = document.getElementById("telemetry-scan-running-text");
            const runningDetail = document.getElementById("telemetry-scan-running-detail");
            const runningProgress = document.getElementById("telemetry-scan-running-progress");
            const runningPct = document.getElementById("telemetry-scan-running-pct");
            if (state === "running" || state === "pending") {
                runningBanner?.classList.remove("d-none");
                if (runningText) runningText.textContent = triggerType === "scheduled"
                    ? "Escaneo programado en curso..."
                    : "Escaneo en curso...";
                if (runningDetail) {
                    const detailParts = [];
                    if (triggerLabel) detailParts.push(triggerLabel);
                    if (currentIpAddress) detailParts.push(currentIpAddress);
                    if (currentStage) detailParts.push(currentStage);
                    runningDetail.textContent = detailParts.join(" · ") || "";
                }
                if (runningProgress) runningProgress.style.width = progressPercent + "%";
                if (runningPct) runningPct.textContent = progressPercent + "%";
            } else {
                runningBanner?.classList.add("d-none");
            }

            if (pauseButton) {
                pauseButton.disabled = !(isConnected && state === "running");
            }

            if (resumeButton) {
                resumeButton.disabled = !(isConnected && state === "paused");
            }

            if (stopButton) {
                stopButton.disabled = !(isConnected && (state === "running" || state === "paused" || state === "pending" || state === "stopping"));
            }

        };

        const loadAgentStatus = (reloadWhenCompleted = false) => {
            fetch("/api/network-telemetry/agent/status", {
                credentials: "include",
                cache: "no-store"
            })
                .then((response) => {
                    if (!response.ok) {
                        throw new Error(`La API respondio ${response.status}`);
                    }
                    return response.json();
                })
                .then((status) => renderAgentStatus(status, reloadWhenCompleted))
                .catch((error) => {
                    console.error("Error cargando estado del agente de telemetria:", error);
                });
        };

        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach((element) => {
            if (window.bootstrap?.Tooltip) {
                new bootstrap.Tooltip(element);
            }
        });

        sessionSearchInput?.addEventListener("input", () => renderSessions(1));
        sessionStateSelect?.addEventListener("change", () => renderSessions(1));
        sessionSortSelect?.addEventListener("change", () => renderSessions(1));
        sessionPageSizeSelect?.addEventListener("change", () => renderSessions(1));
        subnetPageSizeSelect?.addEventListener("change", () => renderSubnetRiskSummaries(1));
        snapshotSearchInput?.addEventListener("input", () => loadSnapshots(1));
        snapshotTriggerSelect?.addEventListener("change", () => loadSnapshots(1));
        snapshotWeekdaySelect?.addEventListener("change", () => loadSnapshots(1));
        snapshotTimeSlotSelect?.addEventListener("change", () => loadSnapshots(1));
        snapshotSortSelect?.addEventListener("change", () => loadSnapshots(1));
        snapshotDirectionSelect?.addEventListener("change", () => loadSnapshots(1));
        snapshotPageSizeSelect?.addEventListener("change", () => loadSnapshots(1));
        scheduledSearchInput?.addEventListener("input", () => loadScheduledScans(1));
        scheduledStatusSelect?.addEventListener("change", () => loadScheduledScans(1));
        scheduledWeekdaySelect?.addEventListener("change", () => loadScheduledScans(1));
        scheduledTimeSlotSelect?.addEventListener("change", () => loadScheduledScans(1));
        scheduledSortSelect?.addEventListener("change", () => loadScheduledScans(1));
        scheduledDirectionSelect?.addEventListener("change", () => loadScheduledScans(1));
        scheduledPageSizeSelect?.addEventListener("change", () => loadScheduledScans(1));
        document.getElementById("telemetry-scheduled-refresh")?.addEventListener("click", () => loadScheduledScans());

        renderSubnetRiskSummaries(1);
        loadDevices(1);
        renderSessions(1);
        loadSnapshots(1);
        loadScheduledScans();
        loadAgentStatus(false);
        window.setInterval(() => loadAgentStatus(true), 5000);
        window.setInterval(() => loadScheduledScans(Number(scheduledTable?.dataset.currentPage || 1), { silent: true }), 30000);
    })();
</script>

<div class="modal fade" id="exportLoadingModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content text-center p-4">
            <div class="spinner-border text-primary mb-3" role="status" style="width:3rem;height:3rem;">
                <span class="visually-hidden">Generando...</span>
            </div>
            <h6 class="mb-1">Generando Excel</h6>
            <p class="small text-muted mb-0">Esto puede tomar unos segundos...</p>
        </div>
    </div>
</div>
