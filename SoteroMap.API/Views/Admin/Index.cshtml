@model SoteroMap.API.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAdmin = User.IsInRole(SoteroMap.API.Models.AppRoles.Admin);
    var totalItems = Math.Max(Model.TotalImportedItems, 1);
    var assignedPercent = Math.Round(Model.AssignedItems * 100.0 / totalItems, 1);
    var pendingPercent = Math.Round(Model.PendingAssignmentItems * 100.0 / totalItems, 1);
    var suggestedPercent = Math.Round(Model.SuggestedItems * 100.0 / totalItems, 1);
    var assignedAngle = Math.Clamp(Model.AssignedItems * 360.0 / totalItems, 0, 360);
    var suggestedAngle = Math.Clamp((Model.AssignedItems + Model.SuggestedItems) * 360.0 / totalItems, 0, 360);
    var maxCategoryCount = Math.Max(Model.CategoryBreakdown.Any() ? Model.CategoryBreakdown.Max(category => category.Count) : 0, 1);
}

<style>
    .dashboard-hero {
        border: 0;
        border-radius: 22px;
        background:
            radial-gradient(circle at top right, rgba(56, 189, 248, 0.22), transparent 34%),
            linear-gradient(135deg, #0f172a 0%, #1e3a5f 48%, #2d79a0 100%);
        color: #fff;
        overflow: hidden;
    }

    .dashboard-hero .text-muted { color: rgba(255, 255, 255, 0.72) !important; }
    .dashboard-card { border: 0; border-radius: 18px; box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08); }
    .dashboard-kpi-icon { width: 52px; height: 52px; display: grid; place-items: center; border-radius: 16px; }
    .assignment-donut {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: conic-gradient(#0ea5e9 0deg @(assignedAngle.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg, #f59e0b @(assignedAngle.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg @(suggestedAngle.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg, #e2e8f0 @(suggestedAngle.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))deg 360deg);
        display: grid;
        place-items: center;
        margin: 0 auto;
        box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.08);
    }

    .assignment-donut::after {
        content: "@assignedPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%";
        width: 118px;
        height: 118px;
        border-radius: 50%;
        background: #fff;
        display: grid;
        place-items: center;
        color: #0f172a;
        font-size: 1.65rem;
        font-weight: 800;
    }

    .chart-legend-dot { width: 10px; height: 10px; border-radius: 999px; display: inline-block; }
    .category-bar-track { height: 10px; border-radius: 999px; background: #e2e8f0; overflow: hidden; }
    .category-bar-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #2d79a0, #38bdf8); }
    .activity-dot { width: 11px; height: 11px; border-radius: 999px; background: #2d79a0; box-shadow: 0 0 0 4px rgba(45, 121, 160, 0.12); }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Dashboard</h2>
    <span class="text-muted">Inventario importado y asignacion manual</span>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card dashboard-hero shadow-sm mb-4">
    <div class="card-body p-4 p-lg-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-7">
                <div class="text-uppercase small fw-semibold text-muted mb-2">Vista general</div>
                <h1 class="fw-bold mb-3">Estado del inventario y mapa</h1>
                <p class="mb-4 text-muted">
                    @Model.AssignedItems equipos ya estan ubicados en el mapa y @Model.PendingAssignmentItems siguen pendientes de asignacion.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="/dashboard/inventory" class="btn btn-light fw-semibold">
                        <i class="bi bi-list-ul me-1"></i> Revisar inventario
                    </a>
                    <a href="/dashboard/locations" class="btn btn-outline-light fw-semibold">
                        <i class="bi bi-buildings me-1"></i> Ver edificios
                    </a>
                    <a href="@Model.FrontendMapUrl" class="btn btn-outline-light fw-semibold js-map-link" target="sotero-map">
                        <i class="bi bi-map me-1"></i> Abrir mapa
                    </a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="bg-white bg-opacity-10 rounded-4 p-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Progreso de asignacion</span>
                        <strong>@assignedPercent.ToString("F1")%</strong>
                    </div>
                    <div class="progress bg-white bg-opacity-25" style="height: 14px;">
                        <div class="progress-bar bg-info" style="width: @assignedPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                    </div>
                    <div class="row text-center mt-4">
                        <div class="col">
                            <div class="fs-3 fw-bold">@Model.TotalImportedItems</div>
                            <div class="small text-muted">Total</div>
                        </div>
                        <div class="col">
                            <div class="fs-3 fw-bold">@Model.AssignedItems</div>
                            <div class="small text-muted">Asignados</div>
                        </div>
                        <div class="col">
                            <div class="fs-3 fw-bold">@Model.PendingAssignmentItems</div>
                            <div class="small text-muted">Pendientes</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

