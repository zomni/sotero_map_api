<div class="row g-4 mb-4">
    <div class="col-lg-4 fade-in-up fade-in-up-d1">
        <div class="card dashboard-card h-100">
            <div class="card-header bg-white fw-semibold">Asignacion de equipos</div>
            <div class="card-body">
                <div class="assignment-donut mb-3"></div>
                <div class="d-grid gap-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span><span class="chart-legend-dot bg-info me-2"></span>Asignados</span>
                        <strong>@Model.AssignedItems (@assignedPercent.ToString("F1")%)</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span><span class="chart-legend-dot bg-warning me-2"></span>Con sugerencia</span>
                        <strong>@Model.SuggestedItems (@suggestedPercent.ToString("F1")%)</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span><span class="chart-legend-dot bg-secondary me-2"></span>Pendientes</span>
                        <strong>@Model.PendingAssignmentItems (@pendingPercent.ToString("F1")%)</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5 fade-in-up fade-in-up-d2">
        <div class="card dashboard-card h-100">
            <div class="card-header bg-white fw-semibold">Categorias principales</div>
            <div class="card-body">
                @if (Model.CategoryBreakdown.Count == 0)
                {
                    <div class="text-muted">Todavia no hay equipos importados.</div>
                }
                else
                {
                    @foreach (var category in Model.CategoryBreakdown)
                    {
                        var width = Math.Round(category.Count * 100.0 / maxCategoryCount, 1);
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-semibold">@category.Category</span>
                                <span class="text-muted">@category.Count</span>
                            </div>
                            <div class="category-bar-track">
                                <div class="category-bar-fill" style="width: @width.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <div class="col-lg-3 fade-in-up fade-in-up-d3">
        <div class="card dashboard-card h-100">
            <div class="card-header bg-white fw-semibold">Pulso operativo</div>
            <div class="card-body d-grid gap-3">
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-muted">Salas</span>
                    <strong>@Model.SyncedRooms</strong>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-muted">Categorias</span>
                    <strong>@Model.DistinctImportedCategories</strong>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2">
                    <span class="text-muted">Robados</span>
                    <strong>@Model.StolenItems</strong>
                </div>
                <div>
                    <div class="small text-muted mb-1">BDD actualizada</div>
                    <div class="fw-semibold">@FormatChileDateTime(Model.DatabaseLastWriteUtc)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card dashboard-card">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-diagram-3 me-2"></i>Red y riesgo</span>
                <a href="/dashboard/network-telemetry" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-arrow-right me-1"></i> Ver detalle
                </a>
            </div>
            <div class="card-body">
                @if (Model.HasNetworkTelemetryData)
                {
                    var riskTone = Model.LatestNetworkRiskLevel switch
                    {
                        "critical" => "danger",
                        "high" => "danger",
                        "medium" => "warning",
                        "low" => "success",
                        _ => "secondary"
                    };
                    var riskLabel = Model.LatestNetworkRiskLevel switch
                    {
                        "critical" => "Critico",
                        "high" => "Alto",
                        "medium" => "Medio",
                        "low" => "Bajo",
                        _ => "Sin datos"
                    };
                    var gaugeInvert = Math.Clamp(100 - Model.LatestNetworkRiskScore, 0, 100);
                    <div class="row g-4 align-items-center">
                        <div class="col-lg-3 col-md-6">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <div class="risk-pulse bg-@riskTone"></div>
                                <div>
                                    <div class="text-muted small">Nivel de riesgo</div>
                                    <div class="fs-4 fw-bold text-@riskTone">@riskLabel</div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Puntaje de riesgo</span>
                                    <span class="fw-semibold">@Model.LatestNetworkRiskScore/100</span>
                                </div>
                                <div class="risk-gauge">
                                    <div class="risk-gauge-fill" style="width: @gaugeInvert%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="dashboard-kpi-icon bg-danger bg-opacity-10">
                                    <i class="bi bi-shield-exclamation text-danger fs-4"></i>
                                </div>
                                <div>
                                    <div class="text-muted small">Dispositivos de alto riesgo</div>
                                    <div class="fs-4 fw-bold">@Model.LatestNetworkHighRiskCount</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="dashboard-kpi-icon bg-info bg-opacity-10">
                                    <i class="bi bi-laptop text-info fs-4"></i>
                                </div>
                                <div>
                                    <div class="text-muted small">Dispositivos detectados</div>
                                    <div class="fs-4 fw-bold">@Model.LatestNetworkDeviceCount</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="d-flex align-items-center gap-3">
                                <div class="dashboard-kpi-icon bg-secondary bg-opacity-10">
                                    <i class="bi bi-clock text-secondary fs-4"></i>
                                </div>
                                <div>
                                    <div class="text-muted small">Ultimo escaneo</div>
                                    <div class="fw-semibold small">@FormatChileDateTime(Model.LatestNetworkScanUtc, "dd/MM/yyyy HH:mm")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-4 align-items-center">
                        <div class="col-lg-8">
                            <div class="d-flex align-items-center gap-3">
                                <div class="dashboard-kpi-icon bg-secondary bg-opacity-10">
                                    <i class="bi bi-diagram-3 text-secondary fs-4"></i>
                                </div>
                                <div>
                                    <div class="fw-semibold">Monitoreo de red y riesgo</div>
                                    <div class="text-muted small mt-1">Escanea tu red para detectar dispositivos conectados, evaluar su nivel de riesgo y mantener un historial de telemetria. Programa escaneos periodicos para mantenerte al dia.</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 text-lg-end">
                            <a href="/dashboard/network-telemetry" class="btn btn-primary">
                                <i class="bi bi-arrow-right me-1"></i> Ir a Red y riesgo
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

