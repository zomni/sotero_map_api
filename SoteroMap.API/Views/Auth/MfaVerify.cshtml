@model SoteroMap.API.ViewModels.MfaVerifyViewModel
@{
    Layout = null;
    ViewData["Title"] = "Verificar MFA";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MFA - SoteroMap Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
        <div class="card border-0 shadow-sm" style="max-width: 420px; width: 100%;">
            <div class="card-body p-4 p-lg-5">
                <div class="mb-4">
                    <h1 class="h3 fw-bold mb-2">Verificar MFA</h1>
                    <p class="text-muted mb-0">Ingresa el codigo de 6 digitos generado por tu aplicacion de autenticacion para @Model.Username.</p>
                </div>

                <form method="post" action="/Auth/MfaVerify">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="Username" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Code" class="form-label"></label>
                        <input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Confirmar</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
