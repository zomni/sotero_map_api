@model SoteroMap.API.ViewModels.MfaSetupViewModel
@{
    Layout = null;
    ViewData["Title"] = "Configurar MFA";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MFA - SoteroMap Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
        <div class="card border-0 shadow-sm" style="max-width: 720px; width: 100%;">
            <div class="card-body p-4 p-lg-5">
                <div class="mb-4">
                    <h1 class="h3 fw-bold mb-2">Configurar MFA para @Model.Username</h1>
                    <p class="text-muted mb-0">Escanea el codigo QR con Microsoft Authenticator o Google Authenticator, o ingresa la clave manualmente.</p>
                </div>

                <div class="row g-4 align-items-start">
                    <div class="col-md-6">
                        <div class="border rounded-3 bg-white p-3 text-center">
                            <img src="@Model.QrSvg" alt="Codigo QR MFA" style="max-width: 100%; height: auto;" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted mb-1">Cuenta</div>
                        <div class="fw-semibold mb-3">@Model.AccountName</div>
                        <div class="small text-muted mb-1">Emisor</div>
                        <div class="fw-semibold mb-3">@Model.Issuer</div>
                        <div class="small text-muted mb-1">Clave manual</div>
                        <div class="font-monospace border rounded px-3 py-2 bg-white mb-3">@Model.SecretDisplay</div>
                        <div class="small text-muted">El enrolamiento expira a las @Model.ExpiresAtUtc.LocalDateTime.ToString("HH:mm")</div>
                        <div class="small text-muted mt-2">Hora servidor: @Model.ServerTimeUtc.LocalDateTime.ToString("HH:mm:ss")</div>
                        <div class="small text-muted">Fecha servidor: @Model.ServerTimeUtc.LocalDateTime.ToString("dd/MM/yyyy")</div>
                        <div class="small text-muted">Hora navegador: <span id="browser-time">--:--:--</span></div>
                        <div class="small text-muted">Fecha navegador: <span id="browser-date">--/--/----</span></div>
                        <a class="btn btn-outline-secondary btn-sm mt-3" href="@Url.Action("MfaSetup", "Auth", new { returnUrl = Model.ReturnUrl, reset = true })">Generar QR nuevo</a>
                    </div>
                </div>

                <form method="post" action="/Auth/MfaSetup" class="mt-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="SetupKey" />
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="Username" />
                    <input type="hidden" asp-for="Issuer" />
                    <input type="hidden" asp-for="AccountName" />
                    <input type="hidden" asp-for="SecretDisplay" />
                    <input type="hidden" asp-for="QrSvg" />
                    <input type="hidden" asp-for="ExpiresAtUtc" />
                    <input type="hidden" asp-for="ServerTimeUtc" />
                    @if (!string.IsNullOrWhiteSpace(Model.DevelopmentExpectedCode))
                    {
                        <div class="alert alert-warning small" role="alert">
                            Diagnostico Development: codigo esperado ahora por el backend
                            <strong class="font-monospace">@Model.DevelopmentExpectedCode</strong>.
                            Si este codigo funciona y Authenticator no, revisa la fecha/hora exacta del telefono o elimina entradas antiguas duplicadas.
                        </div>
                    }
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Code" class="form-label"></label>
                        <input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Activar MFA</button>
                </form>
            </div>
        </div>
    </div>
    <script>
        const browserTime = document.getElementById('browser-time');
        const browserDate = document.getElementById('browser-date');
        const renderBrowserTime = () => {
            const now = new Date();
            browserTime.textContent = now.toLocaleTimeString('es-CL', { hour12: false });
            browserDate.textContent = now.toLocaleDateString('es-CL');
        };
        renderBrowserTime();
        setInterval(renderBrowserTime, 1000);
    </script>
</body>
</html>
