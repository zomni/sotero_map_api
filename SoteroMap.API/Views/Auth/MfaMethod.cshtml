@model SoteroMap.API.ViewModels.MfaMethodViewModel
@{
    Layout = null;
    ViewData["Title"] = "Metodo MFA";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MFA - SoteroMap Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
        <div class="card border-0 shadow-sm" style="max-width: 520px; width: 100%;">
            <div class="card-body p-4 p-lg-5">
                <div class="mb-4">
                    <h1 class="h3 fw-bold mb-2">Verificacion MFA</h1>
                    <p class="text-muted mb-0">Selecciona como quieres comprobar el inicio de sesion para @Model.Username.</p>
                </div>

                <form method="post" action="/Auth/MfaMethod">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="Username" />
                    <input type="hidden" asp-for="Method" value="authenticator" />

                    <button type="submit" class="btn btn-primary w-100 text-start p-3">
                        <span class="d-block fw-semibold">Aplicacion autenticadora</span>
                        <span class="d-block small opacity-75">Microsoft Authenticator / Google Authenticator</span>
                    </button>
                </form>

                <div class="alert alert-info small mt-4 mb-0">
                    El codigo QR solo aparece durante el primer enrolamiento. Si borraste la cuenta desde Authenticator,
                    necesitas resetear el MFA del usuario para generar un QR nuevo.
                </div>

                @if (Model.CanResetInDevelopment)
                {
                    <form method="post" action="/Auth/MfaResetDevelopment" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        <button type="submit" class="btn btn-outline-danger w-100">
                            Resetear MFA y generar QR nuevo
                        </button>
                    </form>
                    <div class="small text-muted mt-2">
                        Opcion disponible solo en Development para pruebas locales.
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>
