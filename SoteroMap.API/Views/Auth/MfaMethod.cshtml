@model SoteroMap.API.ViewModels.MfaMethodViewModel
@{
    Layout = null;
    ViewData["Title"] = "Metodo MFA";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MFA - SoteroMap Admin</title>
    <link rel="icon" type="image/svg+xml" href="/assets/branding/app-logo-backend.svg" />
    <link rel="apple-touch-icon" href="/assets/branding/app-logo-backend.svg" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
        <div class="card border-0 shadow-sm" style="max-width: 520px; width: 100%;">
            <div class="card-body p-4 p-lg-5">
                <div class="mb-4 text-center">
                    <img src="/assets/branding/app-logo-backend.svg" alt="SoteroMap" style="width: 88px; height: 88px; border-radius: 22px; object-fit: cover;" class="mb-3 shadow-sm" />
                    <h1 class="h3 fw-bold mb-0 d-flex align-items-center gap-2">
                        <span>Verificacion MFA</span>
                        <span
                            class="text-muted small"
                            role="button"
                            tabindex="0"
                            data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="Completa el ingreso con tu aplicacion autenticadora configurada para esta cuenta.">
                            <i class="bi bi-info-circle"></i>
                        </span>
                    </h1>
                </div>

                <form method="post" action="/Auth/MfaMethod">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="Username" />
                    <input type="hidden" asp-for="Method" value="authenticator" />

                    <button type="submit" class="btn btn-primary w-100 text-start p-3">
                        <span class="d-block fw-semibold">Aplicacion autenticadora</span>
                        <span class="d-block small opacity-75">Microsoft Authenticator / Google Authenticator</span>
                    </button>
                </form>

                @if (Model.CanResetInDevelopment)
                {
                    <form method="post" action="/Auth/MfaResetDevelopment" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        <button type="submit" class="btn btn-outline-danger w-100">
                            Resetear MFA y generar QR nuevo
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach((element) => {
            new bootstrap.Tooltip(element);
        });
    </script>
</body>
</html>
