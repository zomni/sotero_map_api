{
  "ConnectionStrings": {
    "Default": "Data Source=soteromap.db"
  },
  "AllowedOrigins": "http://localhost:8080,http://localhost:3000",
  "FrontendAppUrl": "http://localhost:8080",
  "AuthSettings": {
    "UseLdapAuthentication": true,
    "AllowLocalBreakGlass": true,
    "BreakGlassUsernames": "ADMIN",
    "AutoProvisionLdapUsers": true,
    "DefaultLdapRole": "viewer"
  },
  "MfaSettings": {
    "Issuer": "SoteroMap",
    "RequireForAdmins": true,
    "RequireForNonAdmins": false,
    "PendingMinutes": 10,
    "PeriodSeconds": 30,
    "Digits": 6,
    "WindowSteps": 6
  },
  "LdapSettings": {
    "Host": "HELIOS.ssmso.cl",
    "FallbackHost": "10.6.50.6",
    "Port": 636,
    "Domain": "SSMSO",
    "BaseDn": "DC=ssmso,DC=cl",
    "UpnSuffixes": "hsr.cl,ssmso.cl,sotero.cl",
    "UseSsl": true,
    "TrustServerCertificate": false
  },
  "CorsSettings": {
    "AllowedOrigins": "http://localhost:8080,http://localhost:3000"
  },
  "SecuritySettings": {
    "ForceHttps": true,
    "EnableSwaggerInProduction": false,
    "CookieSecurePolicy": "SameAsRequest",
    "CookieSameSite": "Lax",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "ContentSecurityPolicy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; connect-src 'self' https: http: ws: wss:; font-src 'self' data: https:"
  },
  "SessionSettings": {
    "IdleMinutes": 15,
    "WarningMinutes": 14,
    "RememberMeDays": 30
  },
  "BackupSettings": {
    "Enabled": true,
    "Cron": "",
    "IntervalHours": 24,
    "RetentionDays": 30
  },
  "NetworkTelemetrySettings": {
    "Enabled": true,
    "FreshnessMinutes": 30,
    "RetentionDays": 90,
    "MaxSnapshots": 100
  },
  "PdfSettings": {
    "MaxUploadBytes": 25000000,
    "AllowedMimeTypes": "application/pdf,application/x-pdf"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}


