{
  "ConnectionStrings": {
    "Default": "Data Source=soteromap.db"
  },
  "AllowedOrigins": "http://localhost:8080,http://localhost:3000",
  "FrontendAppUrl": "http://localhost:8080",
  "AuthSettings": {
    "UseLdapAuthentication": true,
    "AllowLocalBreakGlass": true,
    "BreakGlassUsernames": "ADMIN",
    "AutoProvisionLdapUsers": true,
    "DefaultLdapRole": "viewer"
  },
  "MfaSettings": {
    "Issuer": "SoteroMap",
    "RequireForAdmins": true,
    "RequireForNonAdmins": false,
    "PendingMinutes": 10,
    "PeriodSeconds": 30,
    "Digits": 6,
    "WindowSteps": 6
  },
  "LdapSettings": {
    "Host": "HELIOS.ssmso.cl",
    "FallbackHost": "10.6.50.6",
    "Port": 636,
    "Domain": "SSMSO",
    "BaseDn": "DC=ssmso,DC=cl",
    "UpnSuffixes": "hsr.cl,ssmso.cl,sotero.cl",
    "UseSsl": true,
    "TrustServerCertificate": false
  },
  "CorsSettings": {
    "AllowedOrigins": "http://localhost:8080,http://localhost:3000"
  },
  "SecuritySettings": {
    "ForceHttps": true,
    "EnableSwaggerInProduction": false,
    "DataProtectionKeysPath": "",
    "CookieSecurePolicy": "SameAsRequest",
    "CookieSameSite": "Lax",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "ContentSecurityPolicy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; connect-src 'self' https: http: ws: wss:; font-src 'self' data: https:"
  },
  "SessionSettings": {
    "IdleMinutes": 15,
    "WarningMinutes": 14,
    "RememberMeDays": 30
  },
  "BackupSettings": {
    "Enabled": true,
    "Path": "backups",
    "Cron": "",
    "IntervalHours": 24,
    "RetentionDays": 30
  },
  "NetworkTelemetrySettings": {
    "Enabled": true,
    "ExecutionMode": "agent",
    "AgentSharedPath": "../runtime/network-telemetry-agent",
    "AgentHeartbeatTimeoutSeconds": 30,
    "AutoScanEnabled": true,
    "AutoScanIntervalMinutes": 30,
    "AutoScanCron": "",
    "AutoScanCrons": "0 30 8,13,17 * * 1-4;0 30 8,13,16 * * 5",
    "AutoScanTimeZone": "America/Santiago",
    "ScanCidrs": "10.6.32.0/22,10.6.36.0/23,10.66.180.0/23,10.3.240.0/24,10.6.184.0/24,10.8.90.0/24,10.6.41.0/25",
    "MaxRangesPerScan": 12,
    "MaxHostsPerScan": 4096,
    "MaxConcurrentProbes": 96,
    "PortProbeConcurrency": 16,
    "ScanPorts": "135,139,445,3389,80,443,22,9100,631,515,53,88,389,161,5985,5986,8080,8443",
    "PingTimeoutMs": 250,
    "TcpTimeoutMs": 250,
    "DnsTimeoutMs": 1200,
    "FreshnessMinutes": 30,
    "RetentionDays": 90,
    "MaxSnapshots": 100,
    "IngestApiKey": "SoteroMapNetworkCollector-2026"
  },
  "PdfSettings": {
    "MaxUploadBytes": 25000000,
    "AllowedMimeTypes": "application/pdf,application/x-pdf"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}


